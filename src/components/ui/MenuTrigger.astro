---
const { label = 'Abrir menú' } = Astro.props;
---

<button
  type="button"
  class="menu-trigger"
  data-menu-trigger
  aria-haspopup="dialog"
  aria-expanded="false"
  aria-label={label}
>
  <span class="menu-trigger__lines" aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
  </span>
</button>

<style>
  .menu-trigger {
    position: fixed;
    top: var(--frame-pad);
    right: var(--frame-pad);
    z-index: 50;
    box-sizing: border-box;
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    aspect-ratio: 1;
    padding: 0;
    border: 1.5px solid var(--ink);
    border-radius: 50%;
    background: color-mix(in srgb, var(--paper) 60%, transparent);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    color: var(--ink);
    cursor: pointer;
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0, 1), background-color 0.3s ease;
  }

  .menu-trigger__lines {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    width: 20px;
  }

  .menu-trigger__lines span {
    display: block;
    width: 100%;
    height: 2px;
    border-radius: 1px;
    background: currentColor;
    transition: width 0.3s ease;
  }

  .menu-trigger:hover {
    transform: scale(1.07);
    background: color-mix(in srgb, var(--paper) 85%, transparent);
  }

  .menu-trigger:hover .menu-trigger__lines span:nth-child(2) {
    width: 60%;
  }

  .menu-trigger:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }
</style>
