---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Signature from '../ui/Signature.astro';

// Imágenes en src/assets/projects/salmon/. El nombre de archivo (sin extensión, en
// minúsculas) es la "llave": deja un archivo con ese nombre y reemplaza el placeholder.
const glob = import.meta.glob<ImageMetadata>(
  '../../assets/projects/salmon/*.{jpg,jpeg,png,webp,avif}',
  { eager: true, import: 'default' },
);
const byName: Record<string, ImageMetadata> = {};
for (const [path, img] of Object.entries(glob)) {
  byName[(path.split('/').pop() ?? '').replace(/\.[^.]+$/, '').toLowerCase()] = img;
}

// --- mapa de slots → archivo esperado ---
const hero        = byName['hero']; // ilustración de línea del salmón
const composition = byName['8'];    // composición del libro ABC (S · Salmón · texto)
---

<article
  class="bd"
  data-detail="salmon"
  role="dialog"
  aria-modal="true"
  aria-label="Salmón"
  aria-hidden="true"
  tabindex="-1"
>
  <div class="bd__scroll" data-detail-scroll>
    <header class="bd__bar">
      <button type="button" class="bd__back" data-detail-close aria-label="Volver a proyectos visuales">← volver</button>
      <span class="bd__tag">diseño visual</span>
    </header>

    {/* ---------- hero: ilustración + título encimado ---------- */}
    <section class="bd__hero" data-bd-block>
      <figure class="bd__hero-img">
        {hero
          ? <Image src={hero} alt="Salmón — ilustración" widths={[600, 900, 1240]} sizes="(max-width: 920px) 88vw, 680px" />
          : <div class="bd__ph bd__ph--hero">hero.png</div>}
      </figure>
      <h1 class="bd__display">SALMÓN</h1>
    </section>

    {/* ---------- intro ---------- */}
    <div class="bd__intro" data-bd-block>
      <p>Salmón es una composición visual diseñada para la elaboración de un libro de ABC para niños.</p>
      <p>Dicho trabajo fue desarrollado durante el taller «From Object to Context: A Graphic Journey», impartido por las reconocidas diseñadoras <strong>Maya Kopytman</strong> de G&amp;G Partners y <strong>Gabriela Mirensky</strong> de McCann Worldgroup.</p>
    </div>

    {/* ---------- composición ---------- */}
    <figure class="bd__full" data-bd-block>
      {composition
        ? <Image src={composition} alt="Composición de Salmón para el libro ABC" widths={[700, 1100, 1400]} sizes="(max-width: 920px) 90vw, 820px" />
        : <div class="bd__ph bd__ph--full">8.png — composición del libro ABC</div>}
    </figure>

    {/* ---------- proceso ---------- */}
    <div class="bd__prose" data-bd-block>
      <p>El ejercicio planteado consistía en la selección de un animal cuyo nombre comenzara con la letra del abecedario a preferir. En este caso, la letra <strong>S</strong> y el salmón.</p>
      <p>Posteriormente, se trabajó en la representación visual del mismo por medio de la abstracción de los elementos característicos de este, tales como los lunares, la piel escamosa del animal, así como el hecho que es el único animal en nadar en contra de la corriente.</p>
      <p>A su vez, se realizó la selección tipográfica de acorde a la ilustración realizada.</p>
      <p>Todo esto, persiguiendo desde un inicio las reglas de un enfoque minimalista en cuanto a trazos y colores.</p>
    </div>

    <Signature />
  </div>
</article>

<style>
  .bd {
    position: fixed;
    inset: 0;
    z-index: 45; /* bajo el header (z-50): el nav del sitio queda visible sobre la página */
    background: var(--paper);
    color: var(--ink);
    opacity: 0;
    visibility: hidden; /* gsap autoAlpha lo muestra (openDetail) */
  }
  .bd__scroll {
    height: 100%;
    overflow-y: auto;
    overflow-x: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: clamp(5rem, 13vh, 9rem) var(--frame-pad) clamp(4rem, 12vh, 8rem);
    box-sizing: border-box;
  }
  .bd__scroll::-webkit-scrollbar { display: none; }

  .bd__bar,
  .bd__hero,
  .bd__intro,
  .bd__full,
  .bd__prose,
  .bd :global(.signature) {
    max-width: 840px;
    margin-inline: auto;
  }

  .bd__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: clamp(1.5rem, 4vh, 3rem);
  }
  .bd__back {
    appearance: none; border: 0; background: none; cursor: pointer;
    font-family: var(--font-body); font-weight: 700;
    font-size: clamp(0.85rem, 1.1vw, 1rem);
    color: color-mix(in srgb, var(--ink) 55%, var(--paper));
    transition: color 0.25s ease;
  }
  .bd__back:hover { color: var(--blue); }
  .bd__tag {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--ink) 55%, var(--paper));
  }

  .bd__hero { position: relative; }
  .bd__hero-img { margin: 0; line-height: 0; text-align: center; }
  .bd__hero-img :global(img) {
    display: block;
    margin: 0 auto;
    max-width: 100%;
    max-height: 64vh;
    width: auto;
    height: auto;
  }
  .bd__display {
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translate(-50%, 48%);
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(3rem, 11vw, 8rem);
    line-height: 0.86;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--ink);
    white-space: nowrap;
    pointer-events: none;
  }

  .bd__intro {
    margin-top: clamp(8rem, 17vh, 12rem);
  }
  .bd__intro p {
    margin: 0 0 1.1rem;
    font-family: var(--font-body);
    font-size: clamp(1.02rem, 1.35vw, 1.3rem);
    line-height: 1.58;
    text-align: center;
    color: color-mix(in srgb, var(--ink) 88%, var(--paper));
  }
  .bd__intro strong { font-weight: 700; }

  .bd__full {
    margin-top: clamp(3rem, 8vh, 6rem);
  }
  .bd__full :global(img) { width: 100%; height: auto; display: block; border-radius: 2px; }

  .bd__prose {
    margin-top: clamp(3.5rem, 9vh, 6.5rem);
  }
  .bd__prose p {
    margin: 0 0 1.2rem;
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.25vw, 1.2rem);
    line-height: 1.62;
    color: color-mix(in srgb, var(--ink) 84%, var(--paper));
  }
  .bd__prose strong { font-weight: 700; }

  /* placeholder mientras falta una imagen */
  .bd__ph {
    display: grid;
    place-items: center;
    min-height: 220px;
    padding: 1rem;
    background: color-mix(in srgb, var(--ink) 7%, var(--paper));
    border: 1px dashed color-mix(in srgb, var(--ink) 30%, transparent);
    border-radius: 2px;
    font-family: var(--font-body);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    color: color-mix(in srgb, var(--ink) 55%, var(--paper));
    text-align: center;
  }
  .bd__ph--hero { aspect-ratio: 4 / 5; min-height: 320px; max-width: 320px; margin-inline: auto; }
  .bd__ph--full { aspect-ratio: 16 / 10; }

  @media (max-width: 720px) {
    .bd__display { font-size: clamp(2.4rem, 15vw, 4.5rem); transform: translate(-50%, 38%); }
  }
</style>

<script>
  import { gsap } from '../../lib/gsap';

  // Entrada en cascada al abrir. Selector específico de Salmón para no duplicar
  // observadores con otros detalles que comparten la clase .bd.
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduced) {
    document.querySelectorAll<HTMLElement>('[data-detail="salmon"]').forEach((art) => {
      const blocks = [
        art.querySelector<HTMLElement>('.bd__bar'),
        ...art.querySelectorAll<HTMLElement>('[data-bd-block]'),
      ].filter((b): b is HTMLElement => !!b);
      const mo = new MutationObserver(() => {
        if (art.getAttribute('aria-hidden') === 'false') {
          const scroll = art.querySelector<HTMLElement>('[data-detail-scroll]');
          if (scroll) scroll.scrollTop = 0;
          gsap.from(blocks, { y: 40, autoAlpha: 0, duration: 0.9, ease: 'power3.out', stagger: 0.08, overwrite: 'auto' });
        }
      });
      mo.observe(art, { attributes: true, attributeFilter: ['aria-hidden'] });
    });
  }
</script>
