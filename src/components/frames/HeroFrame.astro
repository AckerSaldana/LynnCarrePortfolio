---
import { Image } from 'astro:assets';
import bouquetImg from '../../assets/projects/bouquet/bouquet-nobg.png';
import titoImg from '../../assets/projects/tito-no-bg.png';

// Frame 0 del stack = la página "Proyectos": selector de categoría.
// Contrato del Observer: data-frame + data-steps="0". Mantiene data-hero (exención de
// pre-pintado en global.css). Dos columnas centradas (recorte sin fondo SOBRE su palabra):
// producto (carrusel, frame 2) y visual (índice visual, frame 3).
// data-nav-target = índice del frame destino. Click en palabra o recorte navega.
---

<section data-frame data-hero data-tag="portada" data-steps="0" class="hero">
  <div class="hero__stage" data-hero-stage>
    <!-- PRODUCTO: recorte (bouquet) centrado sobre la palabra -->
    <div class="hero__cat hero__cat--producto">
      <span class="hero__cut" data-parallax data-depth="0.6" data-cat="producto" data-nav-target="2" aria-hidden="true">
        <Image class="hero__cut-img" src={bouquetImg} alt="" widths={[320, 480, 640]} sizes="(max-width: 720px) 60vw, 24vw" />
      </span>
      <button
        class="hero__word"
        type="button"
        data-cat="producto"
        data-nav-target="2"
        data-parallax
        data-depth="1"
        aria-label="Ver proyectos de producto"
      ><span class="hero__word-inner">producto</span></button>
    </div>

    <!-- VISUAL: recorte (tito) centrado sobre la palabra -->
    <div class="hero__cat hero__cat--visual">
      <span class="hero__cut" data-parallax data-depth="0.6" data-cat="visual" data-nav-target="3" aria-hidden="true">
        <Image class="hero__cut-img" src={titoImg} alt="" widths={[320, 480, 640]} sizes="(max-width: 720px) 60vw, 26vw" />
      </span>
      <button
        class="hero__word"
        type="button"
        data-cat="visual"
        data-nav-target="3"
        data-parallax
        data-depth="1.1"
        aria-label="Ver proyectos visuales"
      ><span class="hero__word-inner">visual</span></button>
    </div>
  </div>
</section>

<style>
  .hero {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--paper);
  }

  .hero__stage {
    position: absolute;
    inset: 0;
  }

  /* cada categoría es una columna centrada: recorte arriba, palabra debajo, mismo eje.
     translateX(-50%) la centra sobre el punto `left` → la imagen queda centrada sobre su palabra. */
  .hero__cat {
    position: absolute;
    top: 14%;
    display: flex;
    flex-direction: column;
    align-items: center;
    transform: translateX(-50%);
  }
  /* simétricos respecto al centro (28% y 72%) */
  .hero__cat--producto { left: 28%; }
  .hero__cat--visual   { left: 72%; }

  /* recorte sin fondo: caja de altura fija para que ambas palabras queden a la misma base */
  .hero__cut {
    height: 52vh;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    will-change: transform;
  }
  .hero__cut-img {
    display: block;
    max-height: 100%;
    width: auto;
    height: auto;
    max-width: 36vw;
    object-fit: contain;
    filter: drop-shadow(0 16px 36px color-mix(in srgb, var(--ink) 15%, transparent));
  }
  /* tito un poco más abajo que bouquet (no mueve la palabra: la caja conserva su alto) */
  .hero__cat--visual .hero__cut-img { transform: translateY(6vh); }

  .hero__word {
    appearance: none;
    border: 0;
    background: none;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    margin-top: clamp(0.6rem, 2.5vh, 2.4rem);
    padding: 0.06em 0.06em 0.2em;
    line-height: 0.88;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.6rem, 8.5vw, 9.5rem);
    letter-spacing: -0.01em;
    color: var(--ink);
    will-change: transform;
  }
  .hero__word-inner { display: block; will-change: transform; transition: color 0.3s ease; }

  /* el hover vive en la PALABRA (vira a azul), no en la imagen */
  .hero__word:hover .hero__word-inner,
  .hero__word.is-hover .hero__word-inner { color: var(--blue); }

  .hero__word:focus-visible { outline: 2px solid var(--ink); outline-offset: 6px; }

  @media (max-width: 720px) {
    /* móvil: columnas apiladas y centradas, producto arriba / visual abajo */
    .hero__cat { transform: translateX(-50%); left: 50%; }
    .hero__cat--producto { top: 7%; }
    .hero__cat--visual   { top: 52%; }
    .hero__cut { height: 26vh; }
    .hero__cut-img { max-width: 62vw; }
    .hero__word { font-size: clamp(2.6rem, 16vw, 5.5rem); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__cut-img { transition: none; }
    .hero__word-inner { transform: none !important; }
  }
</style>

<script>
  import { gsap } from '../../lib/gsap';

  const root = document.querySelector<HTMLElement>('[data-hero]');
  if (root) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const cuts = [...root.querySelectorAll<HTMLElement>('.hero__cut')];
    const inners = [...root.querySelectorAll<HTMLElement>('.hero__word-inner')];

    // hover de la categoría (palabra o recorte) → resalta la PALABRA (azul)
    (['producto', 'visual'] as const).forEach((cat) => {
      const word = root.querySelector<HTMLElement>(`.hero__word[data-cat="${cat}"]`);
      if (!word) return;
      const on = () => word.classList.add('is-hover');
      const off = () => word.classList.remove('is-hover');
      root.querySelectorAll<HTMLElement>(`[data-cat="${cat}"]`).forEach((el) => {
        el.addEventListener('mouseenter', on);
        el.addEventListener('mouseleave', off);
        el.addEventListener('focus', on, true);
        el.addEventListener('blur', off, true);
      });
    });

    if (!reduced) {
      // entrada: los recortes funden (opacidad — el transform lo gobierna el parallax, y la
      // escala del hover vive en el <img> por CSS); las palabras suben tras su máscara.
      gsap.set(cuts, { autoAlpha: 0 });
      gsap.set(inners, { yPercent: 118 });

      gsap.timeline({ delay: 0.12 })
        .to(cuts, { autoAlpha: 1, duration: 0.95, ease: 'power3.out', stagger: 0.12 })
        .to(inners, { yPercent: 0, duration: 0.95, ease: 'power4.out', stagger: 0.1 }, 0.2);

      // parallax por puntero: cada capa con profundidad distinta
      const layers = [...root.querySelectorAll<HTMLElement>('[data-parallax]')].map((el) => ({
        depth: parseFloat(el.dataset.depth || '1'),
        x: gsap.quickTo(el, 'x', { duration: 0.7, ease: 'power3' }),
        y: gsap.quickTo(el, 'y', { duration: 0.7, ease: 'power3' }),
      }));

      window.addEventListener('pointermove', (e) => {
        const nx = (e.clientX / window.innerWidth - 0.5) * 2;
        const ny = (e.clientY / window.innerHeight - 0.5) * 2;
        layers.forEach((l) => { l.x(nx * 16 * l.depth); l.y(ny * 11 * l.depth); });
      });
    }
  }
</script>
