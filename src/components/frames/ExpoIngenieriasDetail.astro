---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Signature from '../ui/Signature.astro';

// Imágenes en src/assets/projects/expo-ingenierias/. El nombre de archivo (sin extensión,
// en minúsculas) es la "llave": deja un archivo con ese nombre y reemplaza el placeholder.
const glob = import.meta.glob<ImageMetadata>(
  '../../assets/projects/expo-ingenierias/*.{jpg,jpeg,png,webp,avif}',
  { eager: true, import: 'default' },
);
const byName: Record<string, ImageMetadata> = {};
for (const [path, img] of Object.entries(glob)) {
  byName[(path.split('/').pop() ?? '').replace(/\.[^.]+$/, '').toLowerCase()] = img;
}

// --- mapa de slots → archivo esperado ---
const hero  = byName['hero']; // logotipo «Ei expo ingenierías» sobre gris
const shotA = byName['1'];    // logotipo en panel azul                ← FALTA
const shotB = byName['2'];    // flyer del evento                      ← FALTA
---

<article
  class="bd"
  data-detail="expo-ingenierias"
  role="dialog"
  aria-modal="true"
  aria-label="Expo Ingenierías"
  aria-hidden="true"
  tabindex="-1"
>
  <div class="bd__scroll" data-detail-scroll>
    <header class="bd__bar">
      <button type="button" class="bd__back" data-detail-close aria-label="Volver a proyectos visuales">← volver</button>
      <span class="bd__tag">diseño visual</span>
    </header>

    {/* ---------- hero: logotipo + título encimado ---------- */}
    <section class="bd__hero" data-bd-block>
      <figure class="bd__hero-img bd__hero-img--panel">
        {hero
          ? <Image src={hero} alt="Expo Ingenierías — logotipo" widths={[600, 900, 1240]} sizes="(max-width: 920px) 88vw, 760px" />
          : <div class="bd__ph bd__ph--hero">hero.png</div>}
      </figure>
      <h1 class="bd__display bd__display--two">EXPO<br />INGENIERÍAS</h1>
    </section>

    {/* ---------- intro ---------- */}
    <div class="bd__intro" data-bd-block>
      <p>Expo Ingenierías es un evento nacional de la Escuela de Ingeniería y Ciencias del Tec de Monterrey que se realiza al final de cada semestre académico.</p>
      <p>En dicho evento se exponen relevantes proyectos estudiantiles que atienden problemas de ingeniería, industria y sociedad, con el objetivo de acercar a alumnos y profesores a un ambiente de innovación y emprendimiento que fortalezca su vinculación con la industria.</p>
      <p>Se elaboró el rediseño del logotipo del evento, así como todo el material gráfico del mismo, el cual va desde flyers hasta agendas y templates de presentaciones, adaptando todos ellos a las necesidades de la escuela con base a su nueva y reciente identidad de marca.</p>
    </div>

    {/* ---------- composición: logotipo en panel ---------- */}
    <figure class="bd__full" data-bd-block>
      {shotA
        ? <Image src={shotA} alt="Expo Ingenierías — logotipo en aplicación" widths={[700, 1100, 1400]} sizes="(max-width: 920px) 90vw, 820px" />
        : <div class="bd__ph bd__ph--full">1.png — logotipo en panel azul</div>}
    </figure>

    {/* ---------- composición: flyer ---------- */}
    <figure class="bd__full" data-bd-block>
      {shotB
        ? <Image src={shotB} alt="Expo Ingenierías — flyer del evento" widths={[700, 1100, 1400]} sizes="(max-width: 920px) 90vw, 820px" />
        : <div class="bd__ph bd__ph--full bd__ph--tall">2.png — flyer del evento</div>}
    </figure>

    <Signature />
  </div>
</article>

<style>
  .bd {
    position: fixed;
    inset: 0;
    z-index: 45; /* bajo el header (z-50): el nav del sitio queda visible sobre la página */
    background: var(--paper);
    color: var(--ink);
    opacity: 0;
    visibility: hidden; /* gsap autoAlpha lo muestra (openDetail) */
  }
  .bd__scroll {
    height: 100%;
    overflow-y: auto;
    overflow-x: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: clamp(5rem, 13vh, 9rem) var(--frame-pad) clamp(4rem, 12vh, 8rem);
    box-sizing: border-box;
  }
  .bd__scroll::-webkit-scrollbar { display: none; }

  .bd__bar,
  .bd__hero,
  .bd__intro,
  .bd__full,
  .bd :global(.signature) {
    max-width: 840px;
    margin-inline: auto;
  }

  .bd__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: clamp(1.5rem, 4vh, 3rem);
  }
  .bd__back {
    appearance: none; border: 0; background: none; cursor: pointer;
    font-family: var(--font-body); font-weight: 700;
    font-size: clamp(0.85rem, 1.1vw, 1rem);
    color: color-mix(in srgb, var(--ink) 55%, var(--paper));
    transition: color 0.25s ease;
  }
  .bd__back:hover { color: var(--blue); }
  .bd__tag {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--ink) 55%, var(--paper));
  }

  .bd__hero { position: relative; }
  .bd__hero-img { margin: 0; line-height: 0; text-align: center; }
  .bd__hero-img :global(img) {
    display: block;
    margin: 0 auto;
    max-width: 100%;
    max-height: 56vh;
    width: auto;
    height: auto;
    border-radius: 2px;
  }
  .bd__display {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    transform: translateY(60%);
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(3rem, 11vw, 8rem);
    line-height: 0.86;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--ink);
    white-space: nowrap;
    pointer-events: none;
  }
  .bd__display--two {
    white-space: normal;
    text-align: center;
    font-size: clamp(2rem, 6.6vw, 4.6rem);
    transform: translateY(60%);
  }

  .bd__intro {
    margin-top: clamp(7rem, 15vh, 11rem);
  }
  .bd__intro p {
    margin: 0 0 1.1rem;
    font-family: var(--font-body);
    font-size: clamp(1.02rem, 1.35vw, 1.3rem);
    line-height: 1.58;
    text-align: center;
    color: color-mix(in srgb, var(--ink) 88%, var(--paper));
  }

  .bd__full {
    margin-top: clamp(3rem, 8vh, 6rem);
  }
  .bd__full :global(img) { width: 100%; height: auto; display: block; border-radius: 2px; }

  /* placeholder mientras falta una imagen */
  .bd__ph {
    display: grid;
    place-items: center;
    min-height: 220px;
    padding: 1rem;
    background: color-mix(in srgb, var(--ink) 7%, var(--paper));
    border: 1px dashed color-mix(in srgb, var(--ink) 30%, transparent);
    border-radius: 2px;
    font-family: var(--font-body);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    color: color-mix(in srgb, var(--ink) 55%, var(--paper));
    text-align: center;
  }
  .bd__ph--hero { aspect-ratio: 4 / 3; min-height: 300px; max-width: 520px; margin-inline: auto; }
  .bd__ph--full { aspect-ratio: 1 / 1; }
  .bd__ph--tall { aspect-ratio: 3 / 4; max-width: 520px; margin-inline: auto; }

  @media (max-width: 720px) {
    .bd__display--two { font-size: clamp(1.7rem, 9vw, 3.4rem); }
  }
</style>

<script>
  import { gsap } from '../../lib/gsap';

  // Entrada en cascada al abrir. Selector específico para no duplicar observadores.
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduced) {
    document.querySelectorAll<HTMLElement>('[data-detail="expo-ingenierias"]').forEach((art) => {
      const blocks = [
        art.querySelector<HTMLElement>('.bd__bar'),
        ...art.querySelectorAll<HTMLElement>('[data-bd-block]'),
      ].filter((b): b is HTMLElement => !!b);
      const mo = new MutationObserver(() => {
        if (art.getAttribute('aria-hidden') === 'false') {
          const scroll = art.querySelector<HTMLElement>('[data-detail-scroll]');
          if (scroll) scroll.scrollTop = 0;
          gsap.from(blocks, { y: 40, autoAlpha: 0, duration: 0.9, ease: 'power3.out', stagger: 0.08, overwrite: 'auto' });
        }
      });
      mo.observe(art, { attributes: true, attributeFilter: ['aria-hidden'] });
    });
  }
</script>
