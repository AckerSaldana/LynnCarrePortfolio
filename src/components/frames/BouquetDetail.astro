---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Signature from '../ui/Signature.astro';

// fotos en src/assets/projects/bouquet/
const glob = import.meta.glob<ImageMetadata>(
  '../../assets/projects/bouquet/*.{jpg,jpeg,png,webp,avif}',
  { eager: true, import: 'default' },
);
const byName: Record<string, ImageMetadata> = {};
for (const [path, img] of Object.entries(glob)) {
  byName[(path.split('/').pop() ?? '').replace(/\.[^.]+$/, '').toLowerCase()] = img;
}
const numbered = Object.entries(byName)
  .filter(([n]) => /^\d+$/.test(n))
  .sort((a, b) => Number(a[0]) - Number(b[0]))
  .map(([, img]) => img);

const hero = byName['bouquet-nobg'] ?? numbered[0]; // cutout protagonista
const grid = numbered.slice(0, 3); // fotos de producto
const workshopImg = numbered[3] ?? numbered[0]; // foto de la página del workshop

const exhibitionLogos = [byName['wanted'], byName['icff'], byName['marco']].filter(Boolean) as ImageMetadata[];
const publicationLogos = [byName['designmilk'], byName['ambientes'], byName['a!']].filter(Boolean) as ImageMetadata[];
---

<article
  class="bd"
  data-detail="bouquet"
  role="dialog"
  aria-modal="true"
  aria-label="Bouquet"
  aria-hidden="true"
  tabindex="-1"
>
  <div class="bd__scroll" data-detail-scroll>
    <header class="bd__bar">
      <button type="button" class="bd__back" data-detail-close>
        <span aria-hidden="true">←</span> Volver
      </button>
      <span class="bd__tag">diseño industrial</span>
    </header>

    {/* ---------- 02 · producto ---------- */}
    <section class="bd__page">
      <div class="bd__grid2">
        <div class="bd__col">
          {grid[0] && <figure class="bd__photo"><Image src={grid[0]} alt="Bouquet" widths={[600, 1000]} sizes="46vw" /></figure>}
          {hero && <figure class="bd__hero"><Image src={hero} alt="Bouquet" widths={[700, 1200]} sizes="(max-width:820px) 90vw, 46vw" /></figure>}
        </div>
        <div class="bd__col">
          {grid[1] && <figure class="bd__photo"><Image src={grid[1]} alt="Bouquet" widths={[500, 900]} sizes="46vw" /></figure>}
          {grid[2] && <figure class="bd__photo"><Image src={grid[2]} alt="Bouquet" widths={[500, 900]} sizes="46vw" /></figure>}
          <div class="bd__lede">
            <h2 class="bd__title">Bouquet</h2>
            <p class="bd__p">Bouquet es un florero inspirado en la forma de un ramo de flores. El concepto surge de la complicada acción de cambiar el agua de un florero durante el paso de los días.</p>
            <p class="bd__p">Consta de dos partes removibles que pueden ser separadas para cambiar el agua con facilidad. Mientras que la parte superior puede ser puesta sobre la mesa a la vez que sostiene cuidadosamente las flores, la parte inferior es llenada con agua para mantener las flores con vida.</p>
            <p class="bd__p">Elaborado en lámina de acero y decorado en colores primarios. El azul representa el papel usado para envolver los ramos de flores, mientras que el verde representa los tallos de las mismas.</p>
          </div>
        </div>
      </div>
      <span class="bd__num">02</span>
    </section>

    {/* ---------- 03 · workshop / exhibiciones ---------- */}
    <section class="bd__page">
      <div class="bd__grid2 bd__grid2--ws">
        <div class="bd__lede">
          <h3 class="bd__title bd__title--ws">Plant-Based Workshop</h3>
          <p class="bd__p"><strong>Bouquet</strong> es un diseño que surge tomando como punto de partida el tema Plant-Based.</p>
          <p class="bd__p">Dicho proyecto se llevó a cabo bajo la mentoría de <strong>Henry Julier</strong>, Director de Diseño Industrial en Standard Issue, y <strong>Jorge Diego Etienne</strong>, diseñador industrial y ex Director Nacional del Programa de Diseño del Tec de Monterrey.</p>
          <p class="bd__p">El ejercicio planteado consistía en la introspección de la relación personal con las plantas para el diseño y conceptualización de objetos como macetas, floreros y soportes para plantas que integraran las necesidades básicas de las mismas con los elementos estéticos y funcionales de la vida cotidiana. Logrando así, la convergencia de estas necesidades con diseños utilitarios que permitieran una síntesis de función y forma. La mentoría de Etienne y Julier aseguró que el prototipo cumpliera con estrictos estándares de funcionalidad, sostenibilidad, durabilidad y belleza.</p>
        </div>
        {workshopImg && <figure class="bd__photo bd__photo--ws"><Image src={workshopImg} alt="Proceso de Bouquet" widths={[600, 1000]} sizes="(max-width:820px) 90vw, 46vw" /></figure>}
      </div>

      <div class="bd__logos">
        {exhibitionLogos.map((logo) => <div class="bd__logo"><Image src={logo} alt="" width={560} /></div>)}
      </div>

      <div class="bd__copy">
        <p class="bd__p">Bouquet se exhibió en plataformas prominentes como <strong>Wanted Design</strong> y la <strong>Feria Internacional del Mueble Contemporáneo (ICFF)</strong> en Manhattan, Nueva York, del 19 al 21 de mayo de 2024. Así como también formó parte de la exhibición de los 25 años del Tec de Monterrey en <strong>Museo MARCO</strong> y de <strong>HORIZONTES</strong>, exhibición nacional de los mejores proyectos de diseño del Tec de Monterrey.</p>
        <p class="bd__p">A su vez, el proyecto ha sido publicado en importantes plataformas de diseño como <u>Design Milk</u>, <u>Revista Ambientes</u> y <u>a! Diseño</u>.</p>
      </div>

      <div class="bd__logos">
        {publicationLogos.map((logo) => <div class="bd__logo"><Image src={logo} alt="" width={560} /></div>)}
      </div>

      <span class="bd__num">03</span>
    </section>

    <Signature />
  </div>
</article>

<style>
  .bd {
    position: fixed;
    inset: 0;
    z-index: 9000;
    background: var(--paper);
    color: var(--ink);
    visibility: hidden;
    opacity: 0;
  }
  .bd__scroll {
    height: 100%;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-width: none;
    padding: var(--frame-pad);
    box-sizing: border-box;
  }
  .bd__scroll::-webkit-scrollbar { display: none; }

  /* contenedor consistente: todo dentro del mismo ancho y márgenes */
  .bd__bar,
  .bd__page {
    max-width: 1280px;
    margin-inline: auto;
  }

  .bd__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .bd__back {
    display: inline-flex;
    gap: 0.5em;
    align-items: center;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }
  .bd__back:hover { opacity: 0.6; }

  .bd__page {
    position: relative;
    padding-block: clamp(2.5rem, 8vh, 6rem);
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
  }
  .bd__page:last-of-type { border-bottom: 0; }

  /* dos columnas consistentes */
  .bd__grid2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: start;
  }
  .bd__grid2--ws { align-items: start; }

  .bd__col {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 2.5vw, 2.5rem);
  }

  /* fotos a su proporción natural (sin recortes raros) */
  .bd__photo {
    margin: 0;
    border-radius: 2px;
    overflow: hidden;
    background: color-mix(in srgb, var(--ink) 5%, var(--paper));
  }
  .bd__photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .bd__hero {
    margin: 0;
  }
  .bd__hero :global(img) {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: 78vh;
    margin-inline: auto;
  }

  .bd__lede { align-self: center; }
  .bd__grid2--ws .bd__lede { align-self: start; }

  .bd__title {
    margin: 0 0 1.4rem;
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: -0.01em;
    font-size: clamp(2.6rem, 5.5vw, 5rem);
  }
  .bd__title--ws { font-size: clamp(1.9rem, 3.8vw, 3.2rem); }

  .bd__p {
    margin: 0 0 1rem;
    max-width: 56ch;
    font-family: var(--font-body);
    font-size: clamp(0.92rem, 1vw, 1.08rem);
    line-height: 1.62;
  }
  .bd__p strong { font-weight: 600; }
  .bd__p u { text-decoration: underline; text-underline-offset: 3px; }

  .bd__copy {
    max-width: 68ch;
    margin-block: clamp(1.5rem, 4vh, 2.5rem);
  }
  .bd__copy .bd__p { max-width: none; }

  /* logos: tres por fila, prominentes, alineados al ancho del contenido */
  .bd__logos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 3vw, 3.5rem);
    align-items: center;
    margin-block: clamp(2rem, 5vh, 3.5rem);
  }
  .bd__logo {
    display: grid;
    place-items: center;
    min-height: clamp(120px, 14vw, 210px);
  }
  .bd__logo :global(img) {
    width: auto;
    height: auto;
    max-width: 96%;
    max-height: clamp(96px, 12vw, 180px);
    object-fit: contain;
  }

  .bd__num {
    position: absolute;
    right: 0;
    bottom: clamp(0.5rem, 2vh, 1.5rem);
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.5vw, 2.6rem);
  }

  @media (max-width: 820px) {
    .bd__grid2 { grid-template-columns: 1fr; }
    .bd__logos { grid-template-columns: repeat(3, 1fr); gap: 1rem; }
    .bd__num { position: static; display: block; margin-top: 1.5rem; }
  }
</style>
