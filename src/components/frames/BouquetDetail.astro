---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Signature from '../ui/Signature.astro';

// Todas las imágenes de Bouquet viven en src/assets/projects/bouquet/.
// El nombre de archivo (sin extensión, en minúsculas) es la "llave" — así puedes
// reemplazar cualquier imagen dejando un archivo con el mismo nombre en esa carpeta.
const glob = import.meta.glob<ImageMetadata>(
  '../../assets/projects/bouquet/*.{jpg,jpeg,png,webp,avif}',
  { eager: true, import: 'default' },
);
const byName: Record<string, ImageMetadata> = {};
for (const [path, img] of Object.entries(glob)) {
  byName[(path.split('/').pop() ?? '').replace(/\.[^.]+$/, '').toLowerCase()] = img;
}

// --- mapa de slots → archivo esperado (lo que va en cada lugar de la página) ---
const hero      = byName['bouquet-nobg'];          // ramo en el florero armado (protagonista)
const sketch    = byName['boceto'];                // boceto / dibujo técnico del concepto  ← FALTA
const shotA     = byName['1'];                      // producto armado (reloj de arena azul+verde)
const shotB     = byName['3'];                      // producto separado (cono verde + vaso azul)
const fullShot  = byName['2'];                      // ramo en el florero + base separada

const exhibitionLogos = [byName['wanted'], byName['icff'], byName['marco']].filter(Boolean) as ImageMetadata[];
const publicationLogos = [byName['designmilk'], byName['ambientes'], byName['a!']].filter(Boolean) as ImageMetadata[];
---

<article
  class="bd"
  data-detail="bouquet"
  role="dialog"
  aria-modal="true"
  aria-label="Bouquet"
  aria-hidden="true"
  tabindex="-1"
>
  <div class="bd__scroll" data-detail-scroll>
    <button type="button" class="bd__back" data-detail-close aria-label="Volver a productos">← volver</button>

    {/* ---------- hero: ramo + título encimado ---------- */}
    <section class="bd__hero" data-bd-block>
      <figure class="bd__hero-img">
        {hero
          ? <Image src={hero} alt="Bouquet — florero con ramo de flores" widths={[600, 900, 1240]} sizes="(max-width: 920px) 88vw, 760px" />
          : <div class="bd__ph bd__ph--hero">bouquet-nobg.png</div>}
      </figure>
      <h1 class="bd__display">BOUQUET</h1>
    </section>

    {/* ---------- intro ---------- */}
    <p class="bd__intro" data-bd-block>
      Bouquet, un florero que abstrae la forma tradicional del ramo de flores y aborda la
      complejidad de la acción de cambiar el agua de las mismas durante el paso de los días.
    </p>

    {/* ---------- boceto ---------- */}
    <figure class="bd__sketch" data-bd-block>
      {sketch
        ? <Image src={sketch} alt="Boceto del concepto de Bouquet" widths={[600, 1000]} sizes="(max-width: 920px) 88vw, 560px" />
        : <div class="bd__ph bd__ph--sketch">boceto.png — boceto del concepto</div>}
    </figure>

    {/* ---------- usuario clave ---------- */}
    <section class="bd__center" data-bd-block>
      <svg class="bd__icon" viewBox="0 0 80 80" fill="none" stroke="currentColor" stroke-width="4" aria-hidden="true">
        <circle cx="40" cy="26" r="15" />
        <path d="M14 70c0-14.4 11.6-26 26-26s26 11.6 26 26" stroke-linecap="round" />
      </svg>
      <h2 class="bd__head">USUARIO CLAVE</h2>
      <p class="bd__lede">Personas de 16 a 60 años, amantes de las flores y la naturaleza.</p>
    </section>

    {/* ---------- insight ---------- */}
    <section class="bd__center" data-bd-block>
      <h2 class="bd__head">INSIGHT</h2>
      <p class="bd__lede">
        Los floreros tradicionales priorizan la exhibición de las flores, pero rara vez consideran
        las necesidades de mantenimiento que ocurren durante el ciclo de vida del arreglo.
      </p>
    </section>

    {/* ---------- proceso / solución ---------- */}
    <div class="bd__prose" data-bd-block>
      <p>Partiendo del cuestionamiento «¿Cuál es la relación de las personas con las plantas en su vida cotidiana?» se identificó:</p>
      <p>Los usuarios de arreglos florales deben retirar las flores para cambiar el agua del florero, una tarea incómoda que aumenta el riesgo de dañar el ramo. Bouquet divide el florero en dos módulos para facilitar el mantenimiento sin alterar la composición floral.</p>
      <p>Mientras la sección superior sostiene el arreglo floral de manera estable, la base puede vaciarse, limpiarse y rellenarse de forma independiente, permitiendo una experiencia de uso más práctica y cómoda.</p>
    </div>

    {/* ---------- dos tomas de producto ---------- */}
    <div class="bd__duo" data-bd-block>
      <figure>
        {shotA
          ? <Image src={shotA} alt="Bouquet armado" widths={[400, 700]} sizes="(max-width: 720px) 88vw, 360px" />
          : <div class="bd__ph">1.png</div>}
      </figure>
      <figure>
        {shotB
          ? <Image src={shotB} alt="Bouquet separado en dos módulos" widths={[400, 700]} sizes="(max-width: 720px) 88vw, 360px" />
          : <div class="bd__ph">3.png</div>}
      </figure>
    </div>

    {/* ---------- materiales ---------- */}
    <section class="bd__center" data-bd-block>
      <h2 class="bd__head">MATERIALES</h2>
      <p class="bd__lede">Elaborado en lámina de acero rolada y pintura electrostática como protección contra el agua.</p>
    </section>

    {/* ---------- costo ---------- */}
    <section class="bd__center" data-bd-block>
      <h2 class="bd__head">COSTO</h2>
      <p class="bd__price">$5,000.00 MXN</p>
    </section>

    {/* ---------- toma completa ---------- */}
    <figure class="bd__full" data-bd-block>
      {fullShot
        ? <Image src={fullShot} alt="Bouquet con la base separada" widths={[700, 1100, 1400]} sizes="(max-width: 920px) 90vw, 820px" />
        : <div class="bd__ph bd__ph--full">2.png</div>}
    </figure>

    {/* ---------- exhibido en ---------- */}
    <section class="bd__center" data-bd-block>
      <h2 class="bd__head">EXHIBIDO EN</h2>
      <div class="bd__logos">
        {exhibitionLogos.map((logo) => <div class="bd__logo"><Image src={logo} alt="" width={560} /></div>)}
      </div>
      <div class="bd__prose bd__prose--center">
        <p>Bouquet se exhibió en plataformas prominentes como <strong>Wanted Design</strong> y la <strong>Feria Internacional del Mueble Contemporáneo (ICFF)</strong> como parte de la colección «Plant Based» en Manhattan, Nueva York, del 19 al 21 de mayo de 2024.</p>
        <p>Así su vez, también formó parte de la exhibición de los 25 años del Tec de Monterrey en <strong>Museo MARCO</strong> y de <strong>HORIZONTES</strong>, exhibición nacional de los mejores proyectos de diseño del Tec de Monterrey.</p>
      </div>
    </section>

    {/* ---------- publicado en ---------- */}
    <section class="bd__center" data-bd-block>
      <h2 class="bd__head">PUBLICADO EN</h2>
      <div class="bd__logos">
        {publicationLogos.map((logo) => <div class="bd__logo"><Image src={logo} alt="" width={560} /></div>)}
      </div>
      <p class="bd__prose bd__prose--center">
        Bouquet ha sido publicado en importantes revistas y plataformas de diseño como
        <span class="bd__link">Design Milk</span>, <span class="bd__link">Revista Ambientes</span>
        y <span class="bd__link">a! Diseño</span>.
      </p>
    </section>

    <Signature />
  </div>
</article>

<style>
  .bd {
    position: fixed;
    inset: 0;
    z-index: 45; /* bajo el header (z-50): el nav del sitio queda visible sobre la página */
    background: var(--paper);
    color: var(--ink);
    opacity: 0;
    visibility: hidden; /* gsap autoAlpha lo muestra (openDetail) */
  }
  .bd__scroll {
    height: 100%;
    overflow-y: auto;
    overflow-x: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: clamp(5rem, 13vh, 9rem) var(--frame-pad) clamp(4rem, 12vh, 8rem);
    box-sizing: border-box;
  }
  .bd__scroll::-webkit-scrollbar { display: none; }

  /* todo el contenido vive en una columna centrada y angosta (lectura cómoda) */
  .bd__hero,
  .bd__intro,
  .bd__sketch,
  .bd__center,
  .bd__prose,
  .bd__duo,
  .bd__full,
  .bd :global(.signature) {
    max-width: 840px;
    margin-inline: auto;
  }

  .bd__back {
    appearance: none; border: 0; background: none; cursor: pointer;
    display: block;
    font-family: var(--font-body); font-weight: 700;
    font-size: clamp(0.85rem, 1.1vw, 1rem);
    color: color-mix(in srgb, var(--ink) 55%, var(--paper));
    transition: color 0.25s ease;
    margin: 0 auto clamp(1.5rem, 4vh, 3rem);
    max-width: 840px;
    width: 100%;
    text-align: left;
  }
  .bd__back:hover { color: var(--blue); }

  /* hero: imagen del ramo con el título encimado en su borde inferior */
  .bd__hero { position: relative; }
  .bd__hero-img { margin: 0; line-height: 0; text-align: center; }
  .bd__hero-img :global(img) {
    display: block;
    margin: 0 auto;
    max-width: 100%;
    max-height: 72vh;
    width: auto;
    height: auto;
  }
  .bd__display {
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translate(-50%, 52%);
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(3rem, 12vw, 9rem);
    line-height: 0.86;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--ink);
    white-space: nowrap;
    pointer-events: none;
  }

  .bd__intro {
    margin-top: clamp(8rem, 17vh, 12rem);
    font-family: var(--font-body);
    font-size: clamp(1.05rem, 1.5vw, 1.4rem);
    line-height: 1.55;
    text-align: center;
    color: color-mix(in srgb, var(--ink) 88%, var(--paper));
  }

  .bd__sketch {
    margin-top: clamp(3rem, 8vh, 6rem);
    text-align: center;
  }
  .bd__sketch :global(img) {
    display: block;
    margin: 0 auto;
    max-width: min(560px, 100%);
    height: auto;
    border-radius: 2px;
  }

  /* bloques centrados: icono / título corto / texto breve */
  .bd__center {
    margin-top: clamp(4rem, 10vh, 7.5rem);
    text-align: center;
  }
  .bd__icon {
    display: block; /* Tailwind pone svg en block: hay que centrarlo con margin auto */
    width: clamp(72px, 9vw, 104px);
    height: clamp(72px, 9vw, 104px);
    color: var(--ink);
    margin: 0 auto clamp(1rem, 2.5vh, 1.75rem);
  }
  .bd__head {
    margin: 0 0 clamp(1rem, 2.5vh, 1.6rem);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 5vw, 3.6rem);
    line-height: 0.95;
    letter-spacing: 0;
    text-transform: uppercase;
  }
  .bd__lede {
    margin: 0 auto;
    max-width: 50ch;
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.3vw, 1.25rem);
    line-height: 1.55;
    color: color-mix(in srgb, var(--ink) 82%, var(--paper));
  }
  .bd__price {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.4rem, 2.4vw, 2.1rem);
    color: var(--blue);
  }

  /* texto de proceso (justificado a la columna) */
  .bd__prose {
    margin-top: clamp(3.5rem, 9vh, 6.5rem);
  }
  .bd__prose p {
    margin: 0 0 1.1rem;
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.25vw, 1.2rem);
    line-height: 1.62;
    color: color-mix(in srgb, var(--ink) 84%, var(--paper));
  }
  .bd__prose strong { font-weight: 700; }
  .bd__prose--center {
    margin-top: clamp(2rem, 5vh, 3rem);
    max-width: 62ch;
    text-align: center;
  }
  .bd__prose--center p { margin-bottom: 1.4rem; }

  /* dos tomas de producto lado a lado */
  .bd__duo {
    margin-top: clamp(3rem, 8vh, 5.5rem);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(0.8rem, 1.8vw, 1.6rem);
  }
  .bd__duo figure { margin: 0; }
  .bd__duo :global(img) {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 2px;
  }

  .bd__full {
    margin-top: clamp(3.5rem, 9vh, 6rem);
  }
  .bd__full :global(img) {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 2px;
  }

  /* logos: en fila, agrupados al centro. Flex (no grid) para que queden centrados
     aunque sean 2 ó 3 — sin columnas vacías que empujen el grupo a un lado. */
  .bd__logos {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(1.25rem, 4vw, 4rem);
    align-items: center;
    margin-block: clamp(2rem, 5vh, 3.25rem);
  }
  .bd__logo {
    flex: 0 0 auto;
    width: clamp(120px, 16vw, 190px);
    display: grid;
    place-items: center;
    min-height: clamp(80px, 11vw, 150px);
  }
  .bd__logo :global(img) {
    width: auto;
    height: auto;
    max-width: 92%;
    max-height: clamp(64px, 9vw, 120px);
    object-fit: contain;
  }

  .bd__link {
    color: var(--blue);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 600;
  }

  /* placeholders mientras falta una imagen (te marcan qué archivo va ahí) */
  .bd__ph {
    display: grid;
    place-items: center;
    min-height: 220px;
    padding: 1rem;
    background: color-mix(in srgb, var(--ink) 7%, var(--paper));
    border: 1px dashed color-mix(in srgb, var(--ink) 30%, transparent);
    border-radius: 2px;
    font-family: var(--font-body);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    color: color-mix(in srgb, var(--ink) 55%, var(--paper));
    text-align: center;
  }
  .bd__ph--hero { aspect-ratio: 3 / 4; min-height: 320px; max-width: 360px; margin-inline: auto; }
  .bd__ph--sketch { aspect-ratio: 16 / 10; }
  .bd__ph--full { aspect-ratio: 16 / 11; }

  @media (max-width: 720px) {
    .bd__display { font-size: clamp(2.4rem, 16vw, 5rem); transform: translate(-50%, 40%); }
    .bd__duo { grid-template-columns: 1fr; }
    .bd__logos { gap: 1rem; }
  }
</style>

<script>
  import { gsap } from '../../lib/gsap';

  // Entrada en cascada al abrir (igual que ProjectDetail): el overlay funde con gsap
  // (openDetail en index) y los bloques suben en secuencia cuando aria-hidden pasa a "false".
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduced) {
    document.querySelectorAll<HTMLElement>('[data-detail="bouquet"]').forEach((art) => {
      const blocks = [
        art.querySelector<HTMLElement>('.bd__back'),
        ...art.querySelectorAll<HTMLElement>('[data-bd-block]'),
      ].filter((b): b is HTMLElement => !!b);
      const mo = new MutationObserver(() => {
        if (art.getAttribute('aria-hidden') === 'false') {
          const scroll = art.querySelector<HTMLElement>('[data-detail-scroll]');
          if (scroll) scroll.scrollTop = 0;
          gsap.from(blocks.slice(0, 6), { y: 40, autoAlpha: 0, duration: 0.9, ease: 'power3.out', stagger: 0.08, overwrite: 'auto' });
        }
      });
      mo.observe(art, { attributes: true, attributeFilter: ['aria-hidden'] });
    });
  }
</script>
