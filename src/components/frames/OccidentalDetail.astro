---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Signature from '../ui/Signature.astro';

// Imágenes en src/assets/projects/occidental/. El nombre de archivo (sin extensión, en
// minúsculas) es la "llave": deja un archivo con ese nombre y reemplaza el placeholder.
const glob = import.meta.glob<ImageMetadata>(
  '../../assets/projects/occidental/*.{jpg,jpeg,png,webp,avif}',
  { eager: true, import: 'default' },
);
const byName: Record<string, ImageMetadata> = {};
for (const [path, img] of Object.entries(glob)) {
  byName[(path.split('/').pop() ?? '').replace(/\.[^.]+$/, '').toLowerCase()] = img;
}

// --- mapa de slots → archivo esperado ---
const hero  = byName['hero']; // patrón de chevrones
const shotA = byName['1'];    // logotipo «Occidental — cuando entiendes todo encaja»  ← FALTA

// liga al manual (cuando la tengas, reemplázala aquí)
const manualUrl = '#';
---

<article
  class="bd"
  data-detail="occidental"
  role="dialog"
  aria-modal="true"
  aria-label="Occidental"
  aria-hidden="true"
  tabindex="-1"
>
  <div class="bd__scroll" data-detail-scroll>
    <header class="bd__bar">
      <button type="button" class="bd__back" data-detail-close aria-label="Volver a proyectos visuales">← volver</button>
      <span class="bd__tag">diseño visual</span>
    </header>

    {/* ---------- hero: patrón + título encimado ---------- */}
    <section class="bd__hero" data-bd-block>
      <figure class="bd__hero-img">
        {hero
          ? <Image src={hero} alt="Occidental — patrón de marca" widths={[600, 900, 1240]} sizes="(max-width: 920px) 88vw, 620px" />
          : <div class="bd__ph bd__ph--hero">hero.png</div>}
      </figure>
      <h1 class="bd__display">OCCIDENTAL</h1>
    </section>

    {/* ---------- intro ---------- */}
    <div class="bd__intro" data-bd-block>
      <p>Como parte de la materia de Branding cursada durante el intercambio internacional en la Universidad de Los Andes en Bogotá, Colombia, se realizó la estrategia de marca e identidad visual de Occidental, empresa del ramo ferretero que buscaba posicionarse y diferenciarse de la competencia.</p>
      <p>Se establecieron la misión, visión, valores y visuales de la marca bajo el concepto de «la ferretería como juguetería de los adultos».</p>
      <p>Dicha identidad visual obtuvo una estrella, reconocimiento más alto otorgado por la Facultad de Arquitectura y Diseño de la universidad, para formar parte del Anuario ArqDis, donde se encuentran los proyectos más destacados realizados por estudiantes de la carrera. A su vez, la estrategia e identidad serán implementadas por el cliente en Occidental.</p>
    </div>

    {/* ---------- composición: logotipo ---------- */}
    <figure class="bd__full" data-bd-block>
      {shotA
        ? <Image src={shotA} alt="Occidental — logotipo y eslogan" widths={[700, 1100, 1400]} sizes="(max-width: 920px) 90vw, 820px" />
        : <div class="bd__ph bd__ph--full">1.png — logotipo «Occidental»</div>}
    </figure>

    {/* ---------- manual ---------- */}
    <p class="bd__action" data-bd-block>
      <a class="bd__manual" href={manualUrl} target="_blank" rel="noopener">Consulta el manual aquí</a>
    </p>

    <Signature />
  </div>
</article>

<style>
  .bd {
    position: fixed;
    inset: 0;
    z-index: 45; /* bajo el header (z-50): el nav del sitio queda visible sobre la página */
    background: var(--paper);
    color: var(--ink);
    opacity: 0;
    visibility: hidden; /* gsap autoAlpha lo muestra (openDetail) */
  }
  .bd__scroll {
    height: 100%;
    overflow-y: auto;
    overflow-x: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: clamp(5rem, 13vh, 9rem) var(--frame-pad) clamp(4rem, 12vh, 8rem);
    box-sizing: border-box;
  }
  .bd__scroll::-webkit-scrollbar { display: none; }

  .bd__bar,
  .bd__hero,
  .bd__intro,
  .bd__full,
  .bd__action,
  .bd :global(.signature) {
    max-width: 840px;
    margin-inline: auto;
  }

  .bd__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: clamp(1.5rem, 4vh, 3rem);
  }
  .bd__back {
    appearance: none; border: 0; background: none; cursor: pointer;
    font-family: var(--font-body); font-weight: 700;
    font-size: clamp(0.85rem, 1.1vw, 1rem);
    color: color-mix(in srgb, var(--ink) 55%, var(--paper));
    transition: color 0.25s ease;
  }
  .bd__back:hover { color: var(--blue); }
  .bd__tag {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--ink) 55%, var(--paper));
  }

  .bd__hero { position: relative; }
  .bd__hero-img { margin: 0; line-height: 0; text-align: center; }
  .bd__hero-img :global(img) {
    display: block;
    margin: 0 auto;
    max-width: min(100%, 560px);
    max-height: 56vh;
    width: auto;
    height: auto;
    border-radius: 2px;
  }
  .bd__display {
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translate(-50%, 52%);
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.6rem, 9.5vw, 7rem);
    line-height: 0.86;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--ink);
    white-space: nowrap;
    pointer-events: none;
  }

  .bd__intro {
    margin-top: clamp(8rem, 17vh, 12rem);
  }
  .bd__intro p {
    margin: 0 0 1.1rem;
    font-family: var(--font-body);
    font-size: clamp(1.02rem, 1.35vw, 1.3rem);
    line-height: 1.58;
    text-align: center;
    color: color-mix(in srgb, var(--ink) 88%, var(--paper));
  }

  .bd__full {
    margin-top: clamp(3rem, 8vh, 6rem);
  }
  .bd__full :global(img) { width: 100%; height: auto; display: block; border-radius: 2px; }

  .bd__action {
    margin-top: clamp(2rem, 5vh, 3.5rem);
    text-align: center;
  }
  .bd__manual {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(1rem, 1.3vw, 1.2rem);
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 2px;
    transition: color 0.25s ease;
  }
  .bd__manual:hover { color: var(--blue); }

  /* placeholder mientras falta una imagen */
  .bd__ph {
    display: grid;
    place-items: center;
    min-height: 220px;
    padding: 1rem;
    background: color-mix(in srgb, var(--ink) 7%, var(--paper));
    border: 1px dashed color-mix(in srgb, var(--ink) 30%, transparent);
    border-radius: 2px;
    font-family: var(--font-body);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    color: color-mix(in srgb, var(--ink) 55%, var(--paper));
    text-align: center;
  }
  .bd__ph--hero { aspect-ratio: 4 / 5; min-height: 360px; max-width: 460px; margin-inline: auto; }
  .bd__ph--full { aspect-ratio: 4 / 3; }

  @media (max-width: 720px) {
    .bd__display { font-size: clamp(2rem, 13vw, 4rem); transform: translate(-50%, 40%); }
  }
</style>

<script>
  import { gsap } from '../../lib/gsap';

  // Entrada en cascada al abrir. Selector específico para no duplicar observadores.
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduced) {
    document.querySelectorAll<HTMLElement>('[data-detail="occidental"]').forEach((art) => {
      const blocks = [
        art.querySelector<HTMLElement>('.bd__bar'),
        ...art.querySelectorAll<HTMLElement>('[data-bd-block]'),
      ].filter((b): b is HTMLElement => !!b);
      const mo = new MutationObserver(() => {
        if (art.getAttribute('aria-hidden') === 'false') {
          const scroll = art.querySelector<HTMLElement>('[data-detail-scroll]');
          if (scroll) scroll.scrollTop = 0;
          gsap.from(blocks, { y: 40, autoAlpha: 0, duration: 0.9, ease: 'power3.out', stagger: 0.08, overwrite: 'auto' });
        }
      });
      mo.observe(art, { attributes: true, attributeFilter: ['aria-hidden'] });
    });
  }
</script>
