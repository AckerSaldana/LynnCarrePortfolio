---
// Carrusel de producto: UN solo frame con N modelos en coverflow horizontal.
// El Observer ya soporta sub-pasos dentro de un frame (data-steps + factory `rotate`):
// cada notch desliza el carrusel de lado a lado mostrando el modelo anterior y el
// posterior asomados en los bordes. Al agotar los sub-pasos, el flip vertical cambia
// de frame como siempre.
//
// data-models = orden de modelos (mapea step -> slug, fuente única de verdad).
// data-steps  = N-1 (3 modelos -> 2 sub-pasos).
// Las etiquetas <button data-carousel-label data-project> son a la vez el rótulo que
// viaja con el rig 3D y el click target que abre el detalle (reusa [data-project]).
interface Project { slug: string; title: string; }
interface Props { projects: Project[]; }
const { projects } = Astro.props;
const slugs = projects.map((p) => p.slug).join(',');
---

<section
  data-frame
  data-carousel
  data-tag="diseño industrial"
  data-models={slugs}
  data-steps={projects.length - 1}
  class="carousel"
>
  <div class="carousel__labels" data-carousel-labels>
    {projects.map((p, i) => (
      <button
        type="button"
        class="carousel__name"
        data-carousel-label
        data-index={i}
        data-project={p.slug}
        tabindex={i === 0 ? 0 : -1}
        aria-hidden={i === 0 ? 'false' : 'true'}
      >{p.title}</button>
    ))}
  </div>
</section>

<style>
  .carousel {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .carousel__labels {
    position: absolute;
    inset: 0;
  }

  /* posición base: ancla en el centro-horizontal y bajo del objeto.
     GSAP es dueño del transform (xPercent/yPercent + x/scale) — no usamos translate aquí. */
  .carousel__name {
    position: absolute;
    left: 50%;
    top: 70%;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    white-space: nowrap;
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: 0;
    font-size: clamp(3rem, 13vw, 13rem);
    color: var(--ink);
    will-change: transform, opacity;
  }

  .carousel__name:hover,
  .carousel__name:focus-visible { color: var(--blue); }

  @media (max-width: 820px) {
    .carousel__name { top: 72%; font-size: clamp(2.4rem, 16vw, 6rem); }
  }
</style>
