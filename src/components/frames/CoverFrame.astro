---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Barcode from '../ui/Barcode.astro';

// El mosaico se arma con TODAS las fotos en src/assets/projects/. Suelta más y aparecen.
const projectImages = import.meta.glob<ImageMetadata>(
  '../../assets/projects/*.{jpg,jpeg,png,webp,avif}',
  { eager: true, import: 'default' },
);

// Etiqueta legible por archivo; las que no estén aquí se prettifican del nombre.
const LABELS: Record<string, string> = {
  bouquet: 'Bouquet', biznaga: 'Biznaga', daylights: 'Daylights',
  bonaterra: 'Bonaterra', bonaterra2: 'Bonaterra', salmon: 'Salmón', tito: 'Tito',
  'expo-ingenierias': 'Expo Ingenierías', occidental: 'Occidental', tec: 'Tec',
  betterware: 'Betterware', 'cocina-habibi': 'Cocina Habibi', decadas: 'Décadas',
  'ellassueñan': 'Ellas Sueñan', manualeic: 'Manual EIC', sacbe: 'Sacbé',
};
const prettify = (s: string) => s.replace(/[-_]+/g, ' ').replace(/\b\w/g, (m) => m.toUpperCase());

const imageEntries = Object.entries(projectImages)
  .map(([path, img]) => {
    const slug = (path.split('/').pop() ?? '').replace(/\.[^.]+$/, '');
    return { img, label: LABELS[slug.toLowerCase()] ?? prettify(slug) };
  })
  .sort((a, b) => a.label.localeCompare(b.label));

// Etiquetas de respaldo si todavía no hay ninguna foto en la carpeta.
const projects = [
  'Bouquet', 'Biznaga', 'Daylights', 'Bonaterra', 'Salmón',
  'Tito', 'Expo Ingenierías', 'Occidental', 'Tec', 'Betterware', 'Cocina Habibi',
];

const COLS = 8;
const PER_COL = 4;

// Acentos puntuales (índice único -> foto a color, sin grayscale). Pocos, "con cuentagotas".
const accents: Record<number, string> = { 3: 'blue', 11: 'yellow', 18: 'green', 26: 'red' };

// Tonos atenuados (fallback cuando un tile no tiene foto).
const tones = [
  'color-mix(in srgb, var(--ink) 7%, var(--paper))',
  'color-mix(in srgb, var(--ink) 13%, var(--paper))',
  'color-mix(in srgb, var(--ink) 9%, var(--paper))',
  'color-mix(in srgb, var(--ink) 17%, var(--paper))',
  'color-mix(in srgb, var(--ink) 6%, var(--paper))',
];

// Grid uniforme columna-mayor; el stride coprimo (×7 sobre 15) reparte las fotos sin repetir vecinas.
const hasImages = imageEntries.length > 0;
const columns = Array.from({ length: COLS }, (_, c) =>
  Array.from({ length: PER_COL }, (_, r) => {
    const i = c * PER_COL + r;
    const entry = hasImages ? imageEntries[(i * 7) % imageEntries.length] : null;
    return {
      label: entry ? entry.label : projects[i % projects.length],
      img: entry?.img,
      accent: accents[i],
      tone: tones[i % tones.length],
    };
  }),
);
---

<section data-frame data-cover data-tag="portada" data-steps="0" class="cover">
  <div class="cover__grid" aria-hidden="true">
    {columns.map((col, ci) => (
      <div class="cover__col" data-col data-dir={ci % 2 === 0 ? 'up' : 'down'}>
        <div class="cover__drift" data-drift>
          {[...col, ...col].map((t) => (
            <figure
              data-tile
              class:list={['tile', t.accent && 'tile--accent', t.accent && `tile--${t.accent}`]}
            >
              {t.img ? (
                <Image class="tile__img" src={t.img} alt="" widths={[320, 640]} sizes="18vw" />
              ) : (
                <div class="tile__media" style={t.accent ? undefined : `--tile-c:${t.tone}`}></div>
              )}
              <figcaption class="tile__name">{t.label}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    ))}
  </div>

  <div class="cover__head">
    <h1 class="cover__title">
      <span class="cover__title-main" data-name>Portafolio</span>
      <span class="cover__title-sub" data-name-meta>de diseño</span>
    </h1>
    <p class="cover__author" data-name-meta>Aylinn Carré</p>
  </div>

  <div class="cover__barcode">
    <Barcode code="5 972985 554741" />
  </div>

  <span class="cover__year" data-name-meta>2026</span>

  <div class="cover__hint" aria-hidden="true">
    <span>Desliza para hojear</span>
    <span class="cover__hint-line"></span>
  </div>
</section>

<style>
  .cover {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--paper);
  }

  /* Grid sobredimensionado y centrado; la inclinación crea la diagonal pareja. */
  .cover__grid {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 160vw;
    height: 200vh;
    transform: translate(-50%, -50%) rotate(-14deg);
    display: flex;
    gap: var(--grid-gutter);
  }

  .cover__col {
    flex: 1;
    min-width: 0;
    will-change: transform;
  }

  .cover__drift {
    display: flex;
    flex-direction: column;
    gap: var(--grid-gutter);
    will-change: transform;
  }

  .tile {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    margin: 0;
    overflow: hidden;
    border-radius: 2px;
    opacity: 0; /* la entrada lo revela; reduced-motion lo restaura abajo */
  }

  .tile__media {
    position: absolute;
    inset: 0;
    background: var(--tile-c, color-mix(in srgb, var(--ink) 12%, var(--paper)));
    filter: grayscale(1);
    transition: filter 0.5s ease, transform 0.7s cubic-bezier(0.2, 0.7, 0, 1);
  }

  .tile__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
    transition: filter 0.5s ease, transform 0.7s cubic-bezier(0.2, 0.7, 0, 1);
  }

  /* lavado de --paper encima para atenuar */
  .tile::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--paper);
    opacity: 0.8;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }

  .tile--accent { --tile-c: var(--accent-c); }
  .tile--accent .tile__media,
  .tile--accent .tile__img { filter: grayscale(0); }
  .tile--accent::after { opacity: 0.52; }
  .tile--blue { --accent-c: var(--blue); }
  .tile--yellow { --accent-c: var(--yellow); }
  .tile--green { --accent-c: var(--green); }
  .tile--red { --accent-c: var(--red); }

  .tile__name {
    position: absolute;
    inset: auto 0 0 0;
    padding: 0.55rem 0.6rem;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--paper);
    background: linear-gradient(to top, color-mix(in srgb, var(--ink) 72%, transparent), transparent);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  .tile:hover .tile__media,
  .tile:hover .tile__img { filter: grayscale(0); transform: scale(1.05); }
  .tile:hover::after { opacity: 0; }
  .tile:hover .tile__name { opacity: 1; transform: none; }

  .cover__head {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    pointer-events: none;
    padding: var(--frame-pad);
  }

  .cover__title {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-end;
    margin: 0;
    line-height: 0.86;
  }

  .cover__title-main {
    display: block;
    overflow: hidden;
    padding: 0.1em 0.05em;
    font-family: var(--font-display);
    font-weight: 400;
    letter-spacing: -0.015em;
    font-size: clamp(3.2rem, 16vw, 14rem);
    color: var(--ink);
    visibility: hidden;
  }

  .cover__title-main :global(.char) { display: inline-block; will-change: transform; }

  .cover__title-sub {
    margin-top: 0.08em;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: clamp(1rem, 3.4vw, 2.6rem);
    color: var(--ink);
  }

  .cover__author {
    margin-top: clamp(1.1rem, 2.8vw, 2.4rem);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(1.6rem, 6vw, 4.4rem);
    letter-spacing: -0.01em;
    color: color-mix(in srgb, var(--ink) 60%, var(--paper));
  }

  .cover__year {
    position: absolute;
    right: var(--frame-pad);
    bottom: var(--frame-pad);
    z-index: 2;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(1.4rem, 3.6vw, 2.8rem);
    color: var(--ink);
  }

  .cover__barcode {
    position: absolute;
    left: var(--frame-pad);
    bottom: var(--frame-pad);
    z-index: 2;
  }

  .cover__hint {
    position: absolute;
    left: 50%;
    bottom: var(--frame-pad);
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    pointer-events: none;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.62rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #fff;
    mix-blend-mode: difference;
  }

  .cover__hint-line {
    width: 1px;
    height: 38px;
    background: currentColor;
    transform-origin: top;
    animation: hint-bob 2.4s ease-in-out infinite;
  }

  @keyframes hint-bob {
    0%, 100% { transform: scaleY(0.4); opacity: 0.4; }
    50% { transform: scaleY(1); opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cover__hint-line { animation: none; }
    .tile { opacity: 1; }
  }
</style>

<script>
  import { gsap, SplitText } from '../../lib/gsap';

  const root = document.querySelector<HTMLElement>('[data-cover]');
  if (root) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const cols = [...root.querySelectorAll<HTMLElement>('[data-col]')];
    const name = root.querySelector<HTMLElement>('[data-name]');
    const meta = root.querySelectorAll<HTMLElement>('[data-name-meta]');

    if (!reduced) {
      const drifts = [...root.querySelectorAll<HTMLElement>('[data-drift]')];
      const boost = window.innerHeight * 0.65;

      drifts.forEach((drift, i) => {
        const up = cols[i].dataset.dir !== 'down';

        // drift constante e infinito; el track mide lo que el contenido, así -50% = una copia (loop sin costura)
        gsap.set(drift, { yPercent: up ? 0 : -50 });
        gsap.to(drift, { yPercent: up ? -50 : 0, duration: 46 + (i % 3) * 9, ease: 'none', repeat: -1 });

        // empuje inicial en la MISMA dirección del drift que se desvanece encima: la velocidad baja suave
        // hasta el ritmo del drift y nunca se frena (el drift sigue corriendo por debajo).
        gsap.from(cols[i], { y: up ? boost : -boost, duration: 2.2, ease: 'expo.out' });
      });

      // los tiles aparecen con stagger (efecto carrete), solo opacidad: nada que frene el movimiento
      gsap.to(root.querySelectorAll('[data-tile]'), {
        autoAlpha: 1,
        duration: 0.6,
        ease: 'power1.out',
        stagger: { each: 0.012, from: 'start' },
      });
    }

    // ocultar el resto de inmediato (sin esperar a fonts.ready) para evitar parpadeo
    if (!reduced) gsap.set(meta, { autoAlpha: 0, y: 16 });

    // título: reveal por caracteres al cargar la fuente; "de diseño", autora y año entran después
    if (name) {
      document.fonts.ready.then(() => {
        gsap.set(name, { autoAlpha: 1 });
        if (reduced) {
          gsap.set(meta, { autoAlpha: 1, y: 0 });
          return;
        }
        const split = new SplitText(name, { type: 'chars', charsClass: 'char' });
        gsap.from(split.chars, {
          yPercent: 115,
          autoAlpha: 0,
          duration: 0.9,
          ease: 'power4.out',
          stagger: 0.045,
        });
        gsap.to(meta, {
          autoAlpha: 1,
          y: 0,
          duration: 0.7,
          ease: 'power2.out',
          stagger: 0.12,
          delay: 0.5,
        });
      });
    }
  }
</script>
