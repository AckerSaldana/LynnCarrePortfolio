---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  slug: string;
  title: string;
  tag: string;
  number: string;
  body: string[];
}

const { slug, title, body } = Astro.props;

// render/foto suelta projects/<slug>.* (respaldo de hero para productos sin galería)
const flat = import.meta.glob<ImageMetadata>(
  '../../assets/projects/*.{jpg,jpeg,png,webp,avif}',
  { eager: true, import: 'default' },
);
let render: ImageMetadata | undefined;
for (const [path, img] of Object.entries(flat)) {
  if ((path.split('/').pop() ?? '').replace(/\.[^.]+$/, '').toLowerCase() === slug) render = img;
}

// galería: SOLO fotos numeradas en projects/<slug>/ (1.png, 2.png…), ignora logos/recortes
const galleryGlob = import.meta.glob<ImageMetadata>(
  '../../assets/projects/*/*.{jpg,jpeg,png,webp,avif}',
  { eager: true, import: 'default' },
);
const photos = Object.entries(galleryGlob)
  .filter(([path]) => (path.split('/projects/')[1] ?? '').startsWith(slug + '/'))
  .filter(([path]) => /^\d+$/.test((path.split('/').pop() ?? '').replace(/\.[^.]+$/, '')))
  .sort((a, b) => a[0].localeCompare(b[0], undefined, { numeric: true }))
  .map(([, img]) => img);

const hero = photos[0] ?? render; // foto principal
const wide = photos[1];            // imagen ancha de la galería
const grid = [photos[2], photos[3]]; // dos imágenes lado a lado
---

<article class="pd" data-detail={slug} role="dialog" aria-modal="true" aria-label={title} aria-hidden="true" tabindex="-1">
  <div class="pd__scroll" data-detail-scroll>
    <button class="pd__back" type="button" data-detail-close aria-label="Volver a productos">← volver</button>

    <section class="pd__hero">
      <figure class="pd__heroimg">
        {hero ? <Image src={hero} alt={title} widths={[600, 900, 1240]} sizes="(max-width: 920px) 92vw, 880px" /> : <div class="pd__ph"></div>}
      </figure>
      <h1 class="pd__title">{title}</h1>
    </section>

    <div class="pd__lede">
      {body.map((p) => <p class="pd__p">{p}</p>)}
    </div>

    <div class="pd__gallery">
      <figure class="pd__wide">
        {wide ? <Image src={wide} alt={`${title} — detalle`} widths={[600, 900, 1240]} sizes="(max-width: 920px) 92vw, 880px" /> : <div class="pd__ph pd__ph--wide"></div>}
      </figure>
      <div class="pd__grid">
        <figure>{grid[0] ? <Image src={grid[0]} alt={`${title} — detalle`} widths={[400, 640]} sizes="(max-width: 920px) 92vw, 430px" /> : <div class="pd__ph"></div>}</figure>
        <figure>{grid[1] ? <Image src={grid[1]} alt={`${title} — detalle`} widths={[400, 640]} sizes="(max-width: 920px) 92vw, 430px" /> : <div class="pd__ph"></div>}</figure>
      </div>
    </div>
  </div>
</article>

<style>
  .pd {
    position: fixed;
    inset: 0;
    z-index: 45; /* bajo el header (z-50) para que el nav del sitio quede visible */
    background: var(--paper);
    color: var(--ink);
    opacity: 0;
    visibility: hidden; /* gsap autoAlpha lo muestra (openDetail) */
  }
  .pd__scroll {
    height: 100%;
    overflow-y: auto;
    overflow-x: hidden;
    -webkit-overflow-scrolling: touch;
    padding: clamp(5rem, 13vh, 9rem) var(--frame-pad) clamp(4rem, 12vh, 9rem);
  }

  .pd__back {
    appearance: none; border: 0; background: none; cursor: pointer;
    font-family: var(--font-body); font-weight: 700;
    font-size: clamp(0.85rem, 1.1vw, 1rem);
    color: color-mix(in srgb, var(--ink) 60%, var(--paper));
    transition: color 0.25s ease;
    margin-bottom: clamp(1.5rem, 4vh, 3rem);
  }
  .pd__back:hover { color: var(--blue); }

  /* hero con el título encimado en su borde inferior. SIN marco de relación fija: la imagen va a su
     tamaño natural (sin franjas/letterbox a los lados), centrada y acotada por ancho/alto. */
  .pd__hero { position: relative; max-width: 880px; margin: 0 auto; }
  .pd__heroimg { margin: 0; line-height: 0; text-align: center; }
  .pd__heroimg :global(img) {
    display: block;
    margin: 0 auto;
    max-width: 100%;
    max-height: 72vh;
    width: auto;
    height: auto;
    border-radius: 2px;
  }
  .pd__hero .pd__ph { aspect-ratio: 16 / 10; } /* respaldo si no hay imagen */
  .pd__title {
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translate(-50%, 36%);
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.4rem, 9vw, 7rem);
    line-height: 0.9;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--ink);
    white-space: nowrap;
    pointer-events: none;
  }

  .pd__lede {
    max-width: 720px;
    margin: clamp(4.5rem, 10vh, 8rem) auto 0;
  }
  .pd__p {
    margin: 0 0 1rem;
    font-size: clamp(1rem, 1.25vw, 1.25rem);
    line-height: 1.55;
    color: color-mix(in srgb, var(--ink) 82%, var(--paper));
  }

  .pd__gallery {
    max-width: 880px;
    margin: clamp(3rem, 8vh, 6rem) auto 0;
    display: grid;
    gap: clamp(0.8rem, 1.5vw, 1.4rem);
  }
  .pd__wide { margin: 0; }
  .pd__wide :global(img),
  .pd__ph--wide { width: 100%; aspect-ratio: 16 / 7; object-fit: cover; display: block; border-radius: 2px; }
  .pd__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(0.8rem, 1.5vw, 1.4rem); }
  .pd__grid figure { margin: 0; }
  .pd__grid :global(img),
  .pd__grid .pd__ph { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; display: block; border-radius: 2px; }
  .pd__ph { width: 100%; height: 100%; min-height: 180px; background: color-mix(in srgb, var(--ink) 8%, var(--paper)); border-radius: 2px; }

  @media (max-width: 720px) {
    .pd__title { font-size: clamp(2rem, 13vw, 4rem); transform: translate(-50%, 30%); }
    .pd__grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { gsap } from '../../lib/gsap';

  // Entrada suave al abrir: el overlay funde (openDetail) y el contenido sube en cascada.
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduced) {
    document.querySelectorAll<HTMLElement>('.pd[data-detail]').forEach((art) => {
      const blocks = [
        art.querySelector<HTMLElement>('.pd__back'),
        art.querySelector<HTMLElement>('.pd__hero'),
        art.querySelector<HTMLElement>('.pd__lede'),
        art.querySelector<HTMLElement>('.pd__gallery'),
      ].filter((b): b is HTMLElement => !!b);
      const mo = new MutationObserver(() => {
        if (art.getAttribute('aria-hidden') === 'false') {
          gsap.from(blocks, { y: 40, duration: 0.95, ease: 'power3.out', stagger: 0.09, overwrite: 'auto' });
        }
      });
      mo.observe(art, { attributes: true, attributeFilter: ['aria-hidden'] });
    });
  }
</script>
