---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  tag: string;
  model?: string;
}

const { title, tag, model } = Astro.props;

// foto del proyecto (mismo slug que el modelo) para la imagen que sigue al cursor
const images = import.meta.glob<ImageMetadata>(
  '../../assets/projects/*.{jpg,jpeg,png,webp,avif}',
  { eager: true, import: 'default' },
);
let photo: ImageMetadata | undefined;
for (const [path, img] of Object.entries(images)) {
  if ((path.split('/').pop() ?? '').replace(/\.[^.]+$/, '').toLowerCase() === model) photo = img;
}
const thumb = photo ? (await getImage({ src: photo, width: 640, format: 'webp' })).src : undefined;
---

<section data-frame data-tag={tag} data-model={model} data-steps="0" class="project">
  <button type="button" class="project__title" data-project={model} data-photo={thumb}>
    {title}
  </button>
</section>

<style>
  /* transparente: el objeto 3D (canvas fijo) se ve por detrás, a la izquierda */
  .project {
    position: absolute;
    inset: 0;
  }

  .project__title {
    position: absolute;
    left: 70%;
    top: 50%;
    transform: translate(-50%, -50%);
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: -0.01em;
    font-size: clamp(3rem, 11vw, 11rem);
    color: var(--ink);
    transition: opacity 0.35s ease;
  }

  .project__title:hover,
  .project__title:focus-visible {
    opacity: 0.6;
  }

  @media (max-width: 820px) {
    .project__title {
      left: 50%;
      top: auto;
      bottom: var(--frame-pad);
      transform: translateX(-50%);
      text-align: center;
      font-size: clamp(2.5rem, 13vw, 5rem);
    }
  }
</style>
