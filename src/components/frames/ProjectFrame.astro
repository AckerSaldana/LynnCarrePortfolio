---
interface Props {
  title: string;
  tag: string;
  model?: string; // slug: data-model activa la escena 3D; data-project abre el detalle
}

const { title, tag, model } = Astro.props;
---

<section data-frame data-tag={tag} data-model={model} data-steps="0" class="project">
  <button type="button" class="project__name" data-project={model}>{title}</button>
</section>

<style>
  .project {
    position: absolute;
    inset: 0;
  }

  /* nombre gigante AL FRENTE del modelo: el canvas 3D vive en z-0, detrás del frame (z-10) */
  .project__name {
    position: absolute;
    left: 50%;
    top: 68%;
    transform: translate(-50%, -50%);
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: 0;
    text-transform: lowercase;
    white-space: nowrap;
    font-size: clamp(3.5rem, 16vw, 16rem);
    color: var(--ink);
    transition: opacity 0.3s ease;
  }
  .project__name:hover,
  .project__name:focus-visible { opacity: 0.6; }

  @media (max-width: 820px) {
    .project__name { top: 70%; font-size: clamp(2.6rem, 18vw, 6rem); }
  }
</style>
