---
import Base from '../layouts/Base.astro';
import HeroFrame from '../components/frames/HeroFrame.astro';
import ProductCarousel from '../components/frames/ProductCarousel.astro';
import BouquetDetail from '../components/frames/BouquetDetail.astro';
import BiznagaDetail from '../components/frames/BiznagaDetail.astro';
import DaylightsDetail from '../components/frames/DaylightsDetail.astro';
import BettercepilloDetail from '../components/frames/BettercepilloDetail.astro';
import BonaterraDetail from '../components/frames/BonaterraDetail.astro';
import SalmonDetail from '../components/frames/SalmonDetail.astro';
import TitoDetail from '../components/frames/TitoDetail.astro';
import ExpoIngenieriasDetail from '../components/frames/ExpoIngenieriasDetail.astro';
import DecadasDetail from '../components/frames/DecadasDetail.astro';
import EllasSuenanDetail from '../components/frames/EllasSuenanDetail.astro';
import SacbeDetail from '../components/frames/SacbeDetail.astro';
import ManualEicDetail from '../components/frames/ManualEicDetail.astro';
import CocinaHabibiDetail from '../components/frames/CocinaHabibiDetail.astro';
import OccidentalDetail from '../components/frames/OccidentalDetail.astro';
import VisualIndex from '../components/frames/VisualIndex.astro';
import VisualFlow from '../components/frames/VisualFlow.astro';
import Header from '../components/ui/Header.astro';
import LandingFrame from '../components/frames/LandingFrame.astro';
import About from '../components/frames/About.astro';
import Contact from '../components/frames/Contact.astro';

// Proyectos (orden = frames 2,3,4...). El copy de Bouquet es del portafolio; el resto, de ejemplo.
const projects = [
  {
    slug: 'bouquet',
    title: 'Bouquet',
    tag: 'diseño industrial',
    number: '02',
    body: [
      'Bouquet es un florero inspirado en la forma de un ramo de flores. El concepto surge de la complicada acción de cambiar el agua de un florero durante el paso de los días.',
      'Consta de dos partes removibles que pueden ser separadas para cambiar el agua con facilidad. Mientras que la parte superior puede ser puesta sobre la mesa a la vez que sostiene cuidadosamente las flores, la parte inferior es llenada con agua para mantener las flores con vida.',
      'Elaborado en lámina de acero y decorado en colores primarios. El azul representa el papel usado para envolver los ramos de flores, mientras que el verde representa los tallos de las mismas.',
    ],
  },
  {
    slug: 'biznaga',
    title: 'Biznaga',
    tag: 'diseño industrial',
    number: '03',
    body: ['— descripción de ejemplo — reemplazar con el texto del portafolio de Biznaga.'],
  },
  {
    slug: 'daylights',
    title: 'Daylights',
    tag: 'diseño industrial',
    number: '04',
    body: ['— descripción de ejemplo — reemplazar con el texto del portafolio de Daylights.'],
  },
  {
    slug: 'bettercepillo',
    title: 'Bettercepillo',
    tag: 'diseño industrial',
    number: '05',
    body: ['— descripción de ejemplo — el detalle usa su página dedicada (BettercepilloDetail).'],
  },
  {
    slug: 'bonaterra',
    title: 'Bonaterra',
    tag: 'diseño industrial',
    number: '06',
    body: ['— descripción de ejemplo — el detalle usa su página dedicada (BonaterraDetail).'],
  },
];

// Perfil: el índice (frame 1) lo usa de manifiesto. Email/teléfono quedan para el colofón.
const profile = {
  name: 'Aylinn Carré',
  location: 'Monterrey, MX',
  email: 'aylinniglerre@gmail.com',
  phone: '232 379 64 17',
};

// Diseño visual (identidad): índice de la sección "visual". Orden = fila en el índice.
// color = campo de identidad del flujo; ink = texto sobre ese color (ajustables).
// description + meta condensados del portafolio (infoproyectos.md), proyectos de Diseño Visual.
const visualProjects = [
  {
    slug: 'bonaterra', title: 'Bonaterra', color: '#4E8067', ink: '#FFFFFF',
    description: 'Identidad visual de la línea de mobiliario Bonaterra: a partir de sus formas curvas y orgánicas se diseñó el logotipo y los manuales de ensamble.',
    meta: 'Identidad de marca · AMA Studio',
  },
  {
    slug: 'salmon', title: 'Salmón', color: '#E8654F', ink: '#FFFFFF',
    description: 'Composición para un libro ABC infantil. El salmón, único pez que nada contra corriente, se abstrae en sus rasgos con un enfoque minimalista.',
    meta: 'Composición editorial · Libro ABC',
  },
  {
    slug: 'tito', title: 'Tito', color: '#2B6BE0', ink: '#FFFFFF',
    description: 'Juguete modular para niños con TEA, de apoyo sensorial y motriz. Se desarrolló su logotipo, identidad y brand book completo.',
    meta: 'Juguete e identidad · Tec + DIF',
  },
  {
    slug: 'expo-ingenierias', title: 'Expo Ingenierías', color: '#E5A11B', ink: '#111111',
    description: 'Rediseño del logotipo y el material gráfico del evento de la Escuela de Ingeniería y Ciencias del Tec, bajo su nueva identidad.',
    meta: 'Identidad de evento · EIC, Tec',
  },
  {
    slug: 'decadas', title: 'Décadas', color: '#3B43C4', ink: '#FFFFFF',
    description: 'Identidad del evento que conmemoró 60 años de la primera computadora en el Tec: logotipo, redes, banners y fondos, con alcance nacional.',
    meta: 'Identidad de evento · Tec de Monterrey',
  },
  {
    slug: 'ellassueñan', title: 'Ellas Sueñan', color: '#D94E8E', ink: '#FFFFFF',
    description: 'Campaña por el Día de la Mujer y la Niña en la Ciencia: niñas que sueñan, jóvenes que investigan y científicas que transforman.',
    meta: 'Campaña · Tec + Ingenia',
  },
  {
    slug: 'sacbe', title: 'Sacbé', color: '#C0392B', ink: '#FFFFFF',
    description: 'Identidad del programa Sacbé STEM, inspirada en los fanzines de los 50s y el empoderamiento femenino para alumnas de prepas públicas.',
    meta: 'Identidad de programa · Sacbé STEM',
  },
  {
    slug: 'manualeic', title: 'Manual EIC', color: '#15807A', ink: '#FFFFFF',
    description: 'Manual de identidad de la campaña de la EIC, bajo el concepto «ingeniería y ciencias encuentra la manera». Lanzado a nivel nacional.',
    meta: 'Manual de marca · EIC, Tec',
  },
  {
    slug: 'cocina-habibi', title: 'Cocina Habibi', color: '#C25A1E', ink: '#FFFFFF',
    description: 'Etiquetas para la línea de congelados de Cocina Habibi, restaurante de comida árabe: kafta y empanadas, a la venta en sucursales.',
    meta: 'Etiquetas de producto · Cocina Habibi',
  },
  {
    slug: 'occidental', title: 'Occidental', color: '#1F3FB8', ink: '#FFFFFF',
    description: 'Estrategia de marca e identidad para la ferretera Occidental, bajo el concepto «la ferretería como juguetería de los adultos».',
    meta: 'Estrategia e identidad · Uniandes',
  },
];

// manifiesto art-directado: segmentos con énfasis tipográfico
const manifesto: { t: string; em?: 'steel' | 'bloom' }[] = [
  { t: 'Diseñadora apasionada del ' },
  { t: 'arte', em: 'steel' },
  { t: ' y las ' },
  { t: 'industrias creativas', em: 'bloom' },
  { t: '.' },
];

---

<Base>
  <canvas data-scene class="fixed inset-0 z-0 pointer-events-none"></canvas>

  <div data-frames class="fixed inset-0 z-10 overflow-hidden">
    <HeroFrame />
    <About />
    <ProductCarousel projects={projects} />
    <VisualIndex projects={visualProjects} />
    <Contact email={profile.email} phone={profile.phone} />
  </div>

  {/* Cada proyecto tiene su página de producto dedicada. */}
  <BouquetDetail />
  <BiznagaDetail />
  <DaylightsDetail />
  <BettercepilloDetail />
  <BonaterraDetail />
  {/* Detalles de proyectos visuales (caso de estudio). El resto sigue usando el VisualFlow. */}
  <SalmonDetail />
  <TitoDetail />
  <ExpoIngenieriasDetail />
  <DecadasDetail />
  <EllasSuenanDetail />
  <SacbeDetail />
  <ManualEicDetail />
  <CocinaHabibiDetail />
  <OccidentalDetail />
  <VisualFlow projects={visualProjects} />

  <div class="cursor-img" data-cursor-img aria-hidden="true"><img alt="" decoding="async" /></div>

  <LandingFrame />
  <Header />
</Base>

<style>
  .cursor-img {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 60;
    width: clamp(190px, 18vw, 340px);
    aspect-ratio: 3 / 4;
    border-radius: 2px;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    will-change: transform;
  }
  .cursor-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>

<script>
  import { gsap, SplitText } from '../lib/gsap';
  import { createFrameNavigator, type FrameRef } from '../lib/observer';
  import { createVisualFlow } from '../lib/visualFlow';
  import { createScene } from '../lib/three/scene';
  import { loadModel, hasModel, getModelTilt, getModelScale } from '../lib/three/models';
  import { Group, Color } from 'three';

  const stack = document.querySelector<HTMLElement>('[data-frames]');
  if (stack) {
    const els = [...stack.querySelectorAll<HTMLElement>('[data-frame]')];
    // Navegación directa (un notch = siguiente frame); sin sub-pasos de rotación.
    const frames: FrameRef[] = els.map((el) => ({ el, steps: Number(el.dataset.steps ?? 0) }));

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // estado inicial: solo el primer frame visible
    gsap.set(els, { autoAlpha: 0 });
    gsap.set(els[0], { autoAlpha: 1 });

    // --- reveal del manifiesto (índice): líneas que suben tras una máscara ---
    const ixSection = els.find((el) => el.classList.contains('ix')) ?? null;
    const ixIndex = ixSection ? els.indexOf(ixSection) : -1;
    let ixSplit: SplitText | null = null;
    let ixReveal: ReturnType<typeof gsap.timeline> | null = null;
    let ixRevealed = false; // el reveal del índice corre una sola vez; reentradas lo dejan completo
    function buildIxReveal() {
      if (!ixSection || reduced) return;
      const manifesto = ixSection.querySelector<HTMLElement>('.ix__manifesto');
      if (!manifesto) return;
      ixSplit?.revert();
      ixSplit = new SplitText(manifesto, { type: 'lines', linesClass: 'ix__line' });
      // máscara propia por línea (con respiro lateral via CSS para no recortar la cursiva)
      ixSplit.lines.forEach((line) => {
        const wrap = document.createElement('span');
        wrap.className = 'ix__line-mask';
        line.parentNode?.insertBefore(wrap, line);
        wrap.appendChild(line);
      });
      ixReveal?.kill();
      ixReveal = gsap
        .timeline({ paused: true })
        .from(ixSplit.lines, { yPercent: 120, duration: 1.1, ease: 'power4.out', stagger: 0.1 })
        .from(
          [...ixSection.querySelectorAll('.ix__meta')],
          { autoAlpha: 0, y: 18, duration: 0.7, ease: 'power3.out' },
          0.3,
        );
      if (ixRevealed) ixReveal.progress(1); // ya se mostró (p.ej. tras resize): déjalo completo
    }
    if (!reduced) {
      if (document.fonts?.ready) document.fonts.ready.then(buildIxReveal);
      else buildIxReveal();
      let ixResizeT = 0;
      window.addEventListener('resize', () => {
        window.clearTimeout(ixResizeT);
        ixResizeT = window.setTimeout(buildIxReveal, 200);
      });
    }

    // --- carrusel de producto: coverflow horizontal (sub-pasos dentro de un frame) ---
    const carouselEl = els.find((el) => el.hasAttribute('data-carousel')) ?? null;
    const carouselIndex = carouselEl ? els.indexOf(carouselEl) : -1;
    const carouselModels = carouselEl?.dataset.models?.split(',').map((s) => s.trim()).filter(Boolean) ?? [];
    const labelEls = carouselEl ? [...carouselEl.querySelectorAll<HTMLElement>('[data-carousel-label]')] : [];
    const REF_SPAN = 2;                 // span normalizado: el modelo activo, al mismo tamaño en pantalla
    const SPACING = REF_SPAN * 1.0;     // separación 3D entre modelos contiguos (tuneable)
    const NEIGHBOR_SCALE = 0.55;        // el modelo anterior/posterior se ve más chico (coverflow)
    const NEIGHBOR_WASH = 0.6;          // ...y más clarito (OPACO, no translúcido): se aclara hacia el fondo
    const PAPER = new Color('#FFFFFF'); // color del fondo hacia el que se aclara el vecino
    let carouselToken = 0;              // descarta layouts obsoletos si entras/sales rápido
    if (labelEls.length) gsap.set(labelEls, { xPercent: -50, yPercent: -50, autoAlpha: 0 });

    // --- frames con scroll nativo propio (Sobre mí, Visual): al entrar apagamos el nav (la rueda
    // no navega entre secciones) y disparamos su reveal; al salir se reactiva. ---
    const aboutEl = els.find((el) => el.hasAttribute('data-about')) ?? null;
    const aboutIndex = aboutEl ? els.indexOf(aboutEl) : -1;
    const aboutScroll = aboutEl?.querySelector<HTMLElement>('[data-about-scroll]') ?? null;
    const visualEl = els.find((el) => el.hasAttribute('data-visual-index')) ?? null;
    const visualFrameIndex = visualEl ? els.indexOf(visualEl) : -1;
    const visualScroll = visualEl?.querySelector<HTMLElement>('[data-visual-scroll]') ?? null;
    const contactEl = els.find((el) => el.hasAttribute('data-contact')) ?? null;
    const contactIndex = contactEl ? els.indexOf(contactEl) : -1;
    const contactScroll = contactEl?.querySelector<HTMLElement>('[data-contact-scroll]') ?? null;
    const scrollFrames = [
      { idx: aboutIndex, scroll: aboutScroll, event: 'about:enter' },
      { idx: visualFrameIndex, scroll: visualScroll, event: 'visual:enter' },
      { idx: contactIndex, scroll: contactScroll, event: 'contact:enter' },
    ].filter((s) => s.idx >= 0);

    // --- escena 3D persistente: carrusel de objetos por proyecto ---
    const canvas = document.querySelector<HTMLCanvasElement>('[data-scene]');
    const sceneHandle = canvas ? createScene(canvas) : null;
    // cada modelo vive en un pivot: el modelo gira solo en Y, el pivot hace el swap (sin chocar)
    const mounted = new Map<string, Group>();
    let sceneIndex = 0;

    function rest(pivot: Group) {
      pivot.position.set(0, 0, 0);
      pivot.scale.setScalar(1);
      pivot.rotation.z = 0;
    }

    // "wash" del modelo: t=0 = activo (normal), t=1 = vecino (más clarito pero OPACO).
    // No usamos opacidad/transparencia (eso lo veía vidrioso/rayos-x): aclaramos con emissive
    // hacia el color del fondo, dejando el material 100% opaco.
    function setPivotWash(pivot: Group, t: number) {
      pivot.traverse((o: any) => {
        if (!o.isMesh || !o.material) return;
        const mats = Array.isArray(o.material) ? o.material : [o.material];
        mats.forEach((m: any) => {
          m.transparent = false; // opaco siempre: sin ver el fondo ni el interior del modelo
          m.opacity = 1;
          m.depthWrite = true;
          if (!m.emissive) return;
          if (m.userData.__em === undefined) {
            m.userData.__em = { hex: m.emissive.getHex(), int: m.emissiveIntensity ?? 1 };
          }
          if (t <= 0) {
            m.emissive.setHex(m.userData.__em.hex); // restaura el emissive original
            m.emissiveIntensity = m.userData.__em.int;
          } else {
            m.emissive.copy(PAPER); // se aclara hacia el fondo
            m.emissiveIntensity = NEIGHBOR_WASH * t;
          }
        });
      });
    }

    async function ensureModel(name: string) {
      if (mounted.has(name)) return mounted.get(name) ?? null;
      const p = loadModel(name);
      if (!p) return null;
      const model = await p;
      if (sceneHandle && !mounted.has(name)) {
        const pivot = new Group();
        const tilt = new Group(); // pose inclinada del modelo, separada del eje de giro
        tilt.add(model);
        pivot.add(tilt);
        sceneHandle.add(pivot);
        sceneHandle.frameObject(model); // centra el modelo dentro del pivot
        // normaliza todos los modelos al mismo span: en el coverflow conviven en una sola
        // toma de cámara, así que deben verse de tamaño parejo sin importar la escala del .glb.
        const span = (model.userData.span as number | undefined) ?? REF_SPAN;
        const k = REF_SPAN / span;
        model.scale.multiplyScalar(k);
        model.position.multiplyScalar(k); // -center → -k·center: sigue centrado tras escalar
        model.userData.span = REF_SPAN;
        pivot.userData.span = REF_SPAN;
        // ajuste fino de tamaño relativo (tras normalizar): el span del pivote se queda en
        // REF_SPAN (cámara y separación del coverflow intactas); solo el modelo se ve más chico/grande.
        const disp = getModelScale(name);
        if (disp !== 1) { model.scale.multiplyScalar(disp); model.position.multiplyScalar(disp); }
        pivot.userData.wash = { v: 0 }; // valor animable de "aclarado" del modelo (0=activo,1=vecino)
        // bouquet/daylights traen emissiveTexture + emissiveFactor BLANCO (pensado para
        // multiplicarse por esa textura casi negra). Quitamos la textura para que el aclarado por
        // emissive funcione, y ponemos el emissive base en NEGRO para que el modelo activo NO brille.
        model.traverse((o: any) => {
          if (!o.isMesh || !o.material) return;
          (Array.isArray(o.material) ? o.material : [o.material]).forEach((m: any) => {
            if (m.emissiveMap) { m.emissiveMap = null; m.needsUpdate = true; }
            if (m.emissive) { m.emissive.setHex(0x000000); m.emissiveIntensity = 1; } // sin glow base
          });
        });
        tilt.rotation.x = getModelTilt(name); // pose inclinada en grupo interno: NO inclina el eje de giro
        pivot.visible = false;
        // giro tipo tornamesa: el pivote gira en la vertical del MUNDO, así el modelo —aunque
        // esté inclinado por dentro— rota parejo alrededor del eje vertical (sin "tumbear").
        if (!reduced) gsap.to(pivot.rotation, { y: '+=' + Math.PI * 2, duration: 32, ease: 'none', repeat: -1 });
        mounted.set(name, pivot);
      }
      return mounted.get(name) ?? null;
    }

    // solo el rótulo centrado abre el detalle; los vecinos asomados no interceptan el click
    function setActiveLabel(step: number) {
      labelEls.forEach((label, i) => {
        const center = i === step;
        label.style.pointerEvents = center ? 'auto' : 'none';
        label.tabIndex = center ? 0 : -1;
        label.setAttribute('aria-hidden', center ? 'false' : 'true');
      });
    }

    // rótulos DOM: el centrado grande+opaco, los vecinos pequeños+tenues, los lejanos ocultos
    function layoutLabels(step: number, animate: boolean) {
      labelEls.forEach((label, i) => {
        const props = {
          xPercent: -50,
          yPercent: -50,
          x: 0,
          y: 0,
          autoAlpha: i === step ? 1 : 0, // solo el modelo actual lleva texto, siempre centrado
        };
        if (animate && !reduced) gsap.to(label, { ...props, duration: 0.6, ease: 'power3.out' });
        else gsap.set(label, props);
      });
      setActiveLabel(step);
    }

    // posiciona los modelos YA montados del carrusel para un sub-paso (síncrono, sin await):
    // X de coverflow, escala y aclarado del vecino, visibles. Reutilizado en la entrada y el layout.
    function placeCarousel(step: number) {
      carouselModels.forEach((name, i) => {
        const pivot = mounted.get(name);
        if (!pivot) return;
        rest(pivot);
        const slot = i - step;
        const t = slot === 0 ? 0 : 1; // 0 = activo, 1 = vecino (aclarado)
        pivot.position.x = slot * SPACING; // prev=-S, activo=0, next=+S
        pivot.scale.setScalar(slot === 0 ? 1 : NEIGHBOR_SCALE); // vecinos más chicos
        (pivot.userData.wash ??= { v: 0 }).v = t;
        setPivotWash(pivot, t); // ...y más claritos (opacos)
        pivot.visible = true; // todos visibles → el anterior y el posterior asoman a los lados
      });
    }

    // entrada al carrusel: asegura montados los tres, encuadra una sola cámara y los reparte en X
    async function layoutCarousel(step: number) {
      if (!sceneHandle || carouselIndex < 0) return;
      const token = ++carouselToken;
      await Promise.all(carouselModels.map((n) => (hasModel(n) ? ensureModel(n) : null)));
      if (token !== carouselToken || sceneIndex !== carouselIndex) return; // entrada superada
      // si los modelos cargaron lento y el usuario ya avanzó, usa el sub-paso vigente
      const liveStep = nav.index === carouselIndex ? nav.step : step;
      sceneHandle.frameToSpan(REF_SPAN); // una sola distancia de cámara para los tres
      placeCarousel(liveStep);
      sceneHandle.setActive(true);
      layoutLabels(liveStep, false);
    }

    function hideCarousel() {
      carouselModels.forEach((n) => { const p = mounted.get(n); if (p) p.visible = false; });
      sceneHandle?.setActive(false);
    }

    // re-asegura el aclarado de cada modelo según el sub-paso vigente (estado final correcto)
    function applyCarouselWash(step: number) {
      carouselModels.forEach((name, i) => {
        const pivot = mounted.get(name);
        if (!pivot) return;
        const t = i - step === 0 ? 0 : 1; // 0 = activo (normal), 1 = vecino (aclarado)
        (pivot.userData.wash ??= { v: 0 }).v = t;
        setPivotWash(pivot, t);
      });
    }

    // ruleta horizontal dentro del frame: cada notch desliza el rig 3D y los rótulos de lado a lado.
    // dur ~0 en reduced-motion (instantáneo pero con duración real, para no romper el onComplete del Observer).
    function rotate(_frame: FrameRef, from: number, to: number, _dir: 1 | -1) {
      const tl = gsap.timeline();
      const dur = reduced ? 0.001 : 0.7;
      carouselModels.forEach((name, i) => {
        const pivot = mounted.get(name);
        if (!pivot) return;
        const slot = i - to;
        const sc = slot === 0 ? 1 : NEIGHBOR_SCALE; // crece al centrarse, encoge al salir
        const toT = slot === 0 ? 0 : 1; // el activo normal, los vecinos aclarados (opacos)
        const wash = (pivot.userData.wash ??= { v: 0 });
        const fromT = wash.v;
        tl.to(pivot.position, { x: slot * SPACING, duration: dur, ease: 'power3.inOut' }, 0);
        // el aclarado viaja con la MISMA tween de escala (que siempre corre), no en una aparte
        tl.to(pivot.scale, {
          x: sc, y: sc, z: sc, duration: dur, ease: 'power3.inOut',
          onUpdate: function () {
            wash.v = fromT + (toT - fromT) * this.progress();
            setPivotWash(pivot, wash.v);
          },
        }, 0);
      });
      // rótulos: crossfade secuencial, sin movimiento — el saliente se desvanece y DESPUÉS aparece
      // el entrante (centrados), así nunca se superponen dos palabras ni se siente "clunky".
      labelEls.forEach((label, i) => {
        if (i === to) {
          if (reduced) { tl.set(label, { autoAlpha: 1 }, 0); return; }
          tl.to(label, { autoAlpha: 1, duration: dur * 0.5, ease: 'power2.out' }, dur * 0.5);
        } else if (i === from) {
          tl.to(label, { autoAlpha: 0, duration: reduced ? 0.001 : dur * 0.5, ease: 'power2.in' }, 0);
        } else {
          tl.set(label, { autoAlpha: 0 }, 0);
        }
      });
      tl.call(() => setActiveLabel(to));
      return tl;
    }

    // Disolución con profundidad (dolly dissolve): el frame saliente se desvanece retrocediendo
    // (escala arriba, acelerando) y el entrante emerge desde un poco más atrás y se asienta a
    // escala 1 (desacelerando). SIN desplazamiento vertical: ya no se siente como un scroll, sino
    // como un corte de cámara. El canvas 3D del carrusel se funde en sincronía (mismo opacity +
    // escala desde el CENTRO del viewport, así modelos y rótulos crecen juntos y alineados).
    function transition(from: HTMLElement, to: HTMLElement, dir: 1 | -1) {
      hideCursorImg(); // si saliste de un frame con preview sin que dispare mouseleave, límpiala
      const tl = gsap.timeline();
      const fromCarousel = from.hasAttribute('data-carousel');
      const toCarousel = to.hasAttribute('data-carousel');
      const enterStep = dir === 1 ? 0 : Number(to.dataset.steps) || 0; // qué modelo queda centrado al entrar
      if (sceneHandle && (fromCarousel || toCarousel)) sceneHandle.setActive(true);

      // monta + coloca el carrusel entrante ANTES de la disolución (se revela al fundir el canvas)
      const armCarousel = () => {
        if (!(toCarousel && sceneHandle)) return;
        sceneHandle.frameToSpan(REF_SPAN);
        placeCarousel(enterStep);
        layoutLabels(enterStep, false);
      };
      // al terminar de fundir hacia afuera el carrusel: oculta modelos y resetea el canvas
      const clearFromCarousel = () => {
        if (!fromCarousel) return;
        hideCarousel();
        if (canvas) gsap.set(canvas, { autoAlpha: 1, clearProps: 'transform' });
      };

      if (reduced) {
        gsap.set(to, { autoAlpha: 0, scale: 1, yPercent: 0 });
        armCarousel();
        if (toCarousel && canvas) gsap.set(canvas, { autoAlpha: 0 });
        tl.to(from, { autoAlpha: 0, duration: 0.3, ease: 'none' }, 0)
          .to(to, { autoAlpha: 1, duration: 0.3, ease: 'none' }, 0);
        if (toCarousel && canvas) tl.to(canvas, { autoAlpha: 1, duration: 0.3 }, 0);
        if (fromCarousel) tl.add(clearFromCarousel, 0.3);
        tl.set(from, { autoAlpha: 0 });
        return tl;
      }

      const OUT = 0.55; // el saliente se va
      const IN = 0.85;  // el entrante llega
      const LAG = 0.3;  // solape: el entrante arranca antes de que el saliente termine

      armCarousel();
      // entrante: invisible y un poco "atrás" (más pequeño), listo para emerger
      gsap.set(to, { autoAlpha: 0, scale: 0.92, yPercent: 0, transformOrigin: '50% 50%' });
      if (toCarousel && canvas) gsap.set(canvas, { autoAlpha: 0, scale: 0.92, transformOrigin: '50% 50%' });

      // saliente: se desvanece retrocediendo
      tl.to(from, { autoAlpha: 0, scale: 1.06, duration: OUT, ease: 'power2.in' }, 0);
      if (fromCarousel && canvas) tl.to(canvas, { autoAlpha: 0, scale: 1.06, duration: OUT, ease: 'power2.in' }, 0);

      // entrante: emerge y se asienta
      tl.to(to, { autoAlpha: 1, scale: 1, duration: IN, ease: 'power3.out' }, LAG);
      if (toCarousel && canvas) tl.to(canvas, { autoAlpha: 1, scale: 1, duration: IN, ease: 'power3.out' }, LAG);

      if (fromCarousel) tl.add(clearFromCarousel, OUT);

      // limpia los transforms residuales (matrix() inline deja el texto microborroso); el saliente
      // queda oculto (autoAlpha 0) y el entrante a escala 1 sin transform.
      tl.set([from, to], { clearProps: 'transform' });
      if (canvas && (fromCarousel || toCarousel)) tl.set(canvas, { clearProps: 'transform' });
      return tl;
    }

    let prevIndex = -1;
    let navReady = false; // evita tocar `nav` en el emit síncrono inicial (TDZ)
    const nav = createFrameNavigator({
      frames,
      transition,
      rotate,
      onChange: (index, step) => {
        const entered = index !== prevIndex;
        const fromContact = entered && prevIndex === contactIndex; // antes de pisar prevIndex
        prevIndex = index;
        sceneIndex = index;
        if (index === carouselIndex) {
          if (entered) layoutCarousel(step); // monta + reparte en X + cámara + activa render
          else { setActiveLabel(step); applyCarouselWash(step); } // re-asegura aclarado del sub-paso
        } else {
          hideCarousel();
        }
        // frames con scroll propio: al entrar apaga el nav (scroll nativo) + dispara su reveal;
        // al salir hacia un frame normal, lo reactiva.
        if (navReady) {
          const sf = scrollFrames.find((s) => s.idx === index);
          if (sf) {
            nav.disable();
            if (entered) {
              if (sf.scroll) sf.scroll.scrollTop = 0;
              window.dispatchEvent(new Event(sf.event));
            }
          } else if (!landingOpen && !detailOpen) {
            nav.enable();
          }
          // contacto: dispara su reveal también en la reentrada vía jumpTo desde la portada
          // (mismo índice, sin "entered"). El primer enter ya lo cubre el flip normal.
          if (index === contactIndex && !entered) window.dispatchEvent(new Event('contact:enter'));
          void fromContact;
        }
        if (index === ixIndex && !ixRevealed) {
          ixRevealed = true;
          ixReveal?.restart();
        }
      },
    });
    navReady = true;

    // --- portada (landing): overlay sin scroll; se sale por el nav del Header ---
    const headerEl = document.querySelector<HTMLElement>('[data-header]');
    const landingEl = document.querySelector<HTMLElement>('[data-landing]');
    let landingOpen = !!landingEl;
    if (landingEl) {
      headerEl?.classList.add('is-on-landing');
      nav.disable(); // arranca congelado: en la portada, wheel/teclado no navegan
    }
    function dismissLanding() {
      if (!landingEl || !landingOpen) return;
      landingOpen = false;
      headerEl?.classList.remove('is-on-landing');
      gsap.to(landingEl, {
        autoAlpha: 0,
        duration: reduced ? 0.2 : 0.6,
        ease: 'power3.in',
        onComplete: () => { landingEl.style.display = 'none'; },
      });
      nav.enable();
    }
    function showLanding() {
      if (!landingEl || landingOpen) return;
      landingOpen = true;
      // la portada tapa el frame sin cambiar de índice: avisa al colofón para que pause su caret
      if (nav.index === contactIndex) window.dispatchEvent(new Event('contact:leave'));
      landingEl.style.display = '';
      headerEl?.classList.add('is-on-landing');
      nav.disable();
      // reinicia la animación CSS del titular (la del primer pintado no se repite sola)
      landingEl.querySelectorAll<HTMLElement>('.landing__line-inner').forEach((ln) => {
        ln.style.animation = 'none'; void ln.offsetWidth; ln.style.animation = '';
      });
      // NO hacemos goTo(0): la portada tapa el frame de fondo, y un goTo aquí deja el nav "animating"
      // ~1.3s, lo que bloqueaba el goTo del siguiente clic (p.ej. "sobre mí" se quedaba en el selector).
      gsap.fromTo(landingEl, { autoAlpha: 0 }, { autoAlpha: 1, duration: reduced ? 0.2 : 0.5, ease: 'power3.out' });
    }

    let detailOpen = false;

    // deja el nav en el estado correcto según el frame actual (apagado en portada/detalle/frames
    // con scroll propio; encendido en el resto). Lo usa el flujo visual al cerrarse.
    function syncNavForCurrentFrame() {
      if (landingOpen || detailOpen) { nav.disable(); return; }
      if (scrollFrames.some((s) => s.idx === nav.index)) nav.disable();
      else nav.enable();
    }

    // Flujo de proyectos visuales: overlay con su propio Observer; pausa el nav principal.
    const flowEl = document.querySelector<HTMLElement>('[data-visual-flow]');
    const flow = flowEl
      ? createVisualFlow({ root: flowEl, reduced, onOpen: () => nav.disable(), onClose: () => syncNavForCurrentFrame() })
      : null;

    // Header + categorías del hero: cada control con data-nav-target salta a su frame.
    document.querySelectorAll<HTMLElement>('[data-nav-target]').forEach((el) => {
      el.addEventListener('click', () => {
        const t = el.dataset.navTarget;
        if (!t) return; // stub: sección por construir
        if (detailOpen) closeDetail(); // si hay un detalle de producto abierto, ciérralo al navegar
        if (landingOpen) {
          // desde la portada: salto INSTANTÁNEO (no se ve el flip desde el selector) + funde la portada
          dismissLanding();
          nav.jumpTo(Number(t));
        } else {
          nav.goTo(Number(t)); // dentro del sitio: flip normal entre secciones
        }
      });
    });
    // wordmark del Header y el botón FIN del colofón → vuelven a la portada
    document.querySelectorAll<HTMLElement>('[data-landing-home]').forEach((b) =>
      b.addEventListener('click', () => {
        if (detailOpen) closeDetail();
        showLanding();
      }),
    );

    // reacomoda el carrusel al redimensionar (separación y rótulos dependen del ancho)
    let carouselResizeT = 0;
    window.addEventListener('resize', () => {
      window.clearTimeout(carouselResizeT);
      carouselResizeT = window.setTimeout(() => {
        if (nav.index === carouselIndex) layoutCarousel(nav.step);
      }, 150);
    });

    // Precarga en segundo plano: monta los .glb del carrusel mientras el navegador está ocioso
    // (estando en el landing/selector), para que "Producto" no espere la descarga/parseo la 1ª vez.
    // Quedan invisibles y sin render (setActive sigue false) hasta entrar al carrusel.
    const warmCarousel = () => carouselModels.forEach((n) => { if (hasModel(n)) ensureModel(n); });
    if ('requestIdleCallback' in window) window.requestIdleCallback(warmCarousel, { timeout: 2500 });
    else window.setTimeout(warmCarousel, 1200);

    // --- imagen que sigue al cursor al pasar por el título de un proyecto ---
    const cursorImg = document.querySelector<HTMLElement>('[data-cursor-img]');
    const cursorImgEl = cursorImg?.querySelector('img') ?? null;
    if (cursorImg && !reduced) {
      gsap.set(cursorImg, { xPercent: -50, yPercent: -50, scale: 0.6 });
      const qx = gsap.quickTo(cursorImg, 'x', { duration: 0.5, ease: 'power3' });
      const qy = gsap.quickTo(cursorImg, 'y', { duration: 0.5, ease: 'power3' });
      window.addEventListener('pointermove', (e) => { qx(e.clientX); qy(e.clientY); });
      // red de seguridad: si el puntero sale de la ventana o pierde foco, limpia el preview
      document.addEventListener('pointerleave', () => hideCursorImg());
      window.addEventListener('blur', () => hideCursorImg());
    }
    function showCursorImg(src?: string) {
      if (!cursorImg || !cursorImgEl || reduced) return;
      if (src) cursorImgEl.src = src;
      gsap.to(cursorImg, { autoAlpha: 1, scale: 1, duration: 0.4, ease: 'power3.out' });
    }
    function hideCursorImg() {
      if (!cursorImg) return;
      gsap.to(cursorImg, { autoAlpha: 0, scale: 0.6, duration: 0.3, ease: 'power3.out' });
    }

    // --- vista detallada editorial (overlay por proyecto) ---
    function openDetail(slug?: string) {
      if (!slug || detailOpen) return;
      const el = document.querySelector<HTMLElement>(`[data-detail="${slug}"]`);
      if (!el) return;
      detailOpen = true;
      hideCursorImg();
      nav.disable();
      const sc = el.querySelector<HTMLElement>('[data-detail-scroll]');
      if (sc) sc.scrollTop = 0;
      el.setAttribute('aria-hidden', 'false'); // dispara la entrada escalonada del contenido (ProjectDetail)
      gsap.fromTo(el, { autoAlpha: 0 }, { autoAlpha: 1, duration: reduced ? 0.2 : 0.55, ease: 'power2.out' });
      el.focus();
    }
    function closeDetail() {
      const el = document.querySelector<HTMLElement>('[data-detail][aria-hidden="false"]');
      if (!el) return;
      detailOpen = false;
      gsap.to(el, {
        autoAlpha: 0,
        duration: reduced ? 0.15 : 0.4,
        ease: 'power3.in',
        onComplete: () => el.setAttribute('aria-hidden', 'true'),
      });
      // restaura el nav según el frame de fondo: enable en el carrusel, disable si el detalle
      // se abrió sobre un frame con scroll propio (p.ej. el índice visual).
      syncNavForCurrentFrame();
    }

    // títulos de proyecto: hover muestra la imagen, click abre el detalle
    [...document.querySelectorAll<HTMLElement>('[data-project]')].forEach((t) => {
      if (t.dataset.photo) {
        t.addEventListener('mouseenter', () => showCursorImg(t.dataset.photo));
        t.addEventListener('mouseleave', hideCursorImg);
      }
      t.addEventListener('click', () => {
        const slug = t.dataset.project ?? '';
        // visual: si el proyecto ya tiene página dedicada (caso de estudio) la abre; si no,
        // cae al VisualFlow. Producto: abre su detalle.
        if (t.dataset.visual !== undefined) {
          hideCursorImg();
          if (document.querySelector(`[data-detail="${slug}"]`)) openDetail(slug);
          else flow?.openBySlug(slug);
        } else {
          openDetail(slug);
        }
      });
    });
    document.querySelectorAll<HTMLElement>('[data-detail-close]').forEach((b) => b.addEventListener('click', closeDetail));
    window.addEventListener('keydown', (e) => { if (e.key === 'Escape' && detailOpen) closeDetail(); });
  }
</script>
